.avatar-cropper{position:fixed;z-index:9999;top:0;right:0;bottom:0;left:0;display:flex;flex-direction:column;color:#fff;background:#111}.cropper-safe{height:env(safe-area-inset-top);min-height:28rpx}.cropper-title{height:88rpx;font-size:29rpx;font-weight:700;line-height:88rpx;text-align:center}.cropper-stage{display:flex;flex:1;min-height:0;align-items:center;justify-content:center}.cropper-frame{position:relative;overflow:hidden;border-radius:50%;background:#252525;box-shadow:0 0 0 9999rpx rgba(0,0,0,.34)}.cropper-image{position:absolute;display:block;transform-origin:center}.cropper-ring{position:absolute;z-index:2;top:0;right:0;bottom:0;left:0;box-sizing:border-box;border:3rpx solid rgba(255,255,255,.94);border-radius:50%;pointer-events:none}.cropper-loading{color:#BFC4C1;font-size:24rpx}.cropper-tip{padding:28rpx 24rpx 12rpx;color:#C7CCC9;font-size:23rpx;text-align:center}.cropper-actions{display:flex;align-items:center;justify-content:space-between;padding:8rpx 28rpx 13rpx}.toolbar-action{min-width:112rpx;padding:17rpx 6rpx;color:#fff;font-size:28rpx;text-align:left}.toolbar-action.confirm{color:#76D69B;text-align:right;font-weight:700}.cropper-bottom{height:env(safe-area-inset-bottom);min-height:20rpx}.avatar-output-canvas{position:fixed;z-index:-1;left:-1000px;top:-1000px;width:600px;height:600px;opacity:0;pointer-events:none}
