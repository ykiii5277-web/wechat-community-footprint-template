.comment-panel { margin-top:24rpx; padding:24rpx 25rpx; background:#FFFCF6; border-radius:20rpx; box-shadow:0 10rpx 30rpx rgba(39,70,52,.08); }.comment-heading { color:#1F513E; font-size:27rpx; font-weight:700; }.comment-heading text { color:#819087; font-weight:400; }.comment-list { margin-top:10rpx; }.comment-thread { padding:4rpx 0 14rpx; border-bottom:1rpx solid #EEEAE0; }.comment-thread:last-child { border-bottom:0; }.comment-item,.comment-reply-item { display:flex; align-items:flex-start; padding:13rpx 0; }.comment-avatar { display:flex; align-items:center; justify-content:center; width:46rpx; height:46rpx; flex:0 0 46rpx; overflow:hidden; margin-right:13rpx; border-radius:50%; color:#fff; background:#799B85; font-size:21rpx; }.comment-avatar image { display:block; width:100%; height:100%; transform-origin:center; }.reply-avatar { width:40rpx; height:40rpx; flex-basis:40rpx; font-size:18rpx; }.comment-copy { flex:1; min-width:0; }.comment-author { color:#426850; font-size:22rpx; font-weight:700; }.comment-reply-to { display:inline-block; margin-top:4rpx; color:#668271; font-size:19rpx; }.comment-body { margin-top:4rpx; color:#42594C; font-size:24rpx; line-height:1.6; white-space:pre-wrap; }.comment-meta { margin-top:5rpx; color:#9AA59D; font-size:18rpx; }.comment-actions { display:flex; flex:0 0 auto; align-items:center; margin-left:8rpx; color:#CF6A60; text-align:center; }.comment-like { display:flex; align-items:center; justify-content:center; min-width:66rpx; min-height:66rpx; padding:6rpx 10rpx; box-sizing:border-box; border-radius:99rpx; background:#FFF1EC; font-size:39rpx; line-height:1; }.comment-thread-toggle { display:inline-flex; align-items:center; gap:6rpx; margin:0 0 3rpx 59rpx; padding:7rpx 12rpx; border-radius:99rpx; color:#527661; background:#EEF4EC; font-size:19rpx; }.thread-toggle-icon { color:#2F6A4E; font-size:21rpx; line-height:1; }.comment-replies { margin:8rpx 0 0 59rpx; padding:4rpx 13rpx; border-left:3rpx solid #CFE0D1; border-radius:0 13rpx 13rpx 0; background:#F7F9F4; }.comment-reply-item { padding:13rpx 0; border-bottom:1rpx solid #E5ECE2; }.comment-reply-item:last-child { border-bottom:0; }.comment-reply-item .comment-body { font-size:22rpx; }.comment-reply-item .comment-actions { margin-left:7rpx; }.no-comment { margin:18rpx 0; color:#9AA59D; font-size:23rpx; }.reply-banner { display:flex; justify-content:space-between; margin-top:16rpx; padding:9rpx 13rpx; border-radius:12rpx; color:#577363; background:#EDF3E9; font-size:20rpx; }.reply-banner text { color:#997044; }.comment-composer { display:flex; gap:12rpx; align-items:center; margin-top:20rpx; }.comment-input { height:66rpx; flex:1; box-sizing:border-box; min-width:0; padding:0 17rpx; color:#20362C; background:#F4F2EB; border-radius:99rpx; font-size:24rpx; }.comment-send { padding:13rpx 17rpx; border-radius:99rpx; color:#fff; background:#1F513E; font-size:23rpx; }
