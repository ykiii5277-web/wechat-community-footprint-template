.scene { height: 310rpx; position: relative; overflow: hidden; border-radius: 0 0 28rpx 28rpx; background: linear-gradient(#DCEAF0 0%, #ECF1DF 62%, #D6E0C0 100%); }
.scene-image { position:absolute; z-index:20; inset:0; width:100%; height:100%; }
.scene.compact { height: 206rpx; border-radius: 18rpx; }
.cloud { position: absolute; border-radius: 100rpx; background: rgba(255,255,255,.67); width: 150rpx; height: 30rpx; top: 38rpx; }
.cloud:before,.cloud:after { content:''; position:absolute; bottom: 11rpx; border-radius: 50%; background: inherit; }
.cloud:before { width: 52rpx; height: 52rpx; left: 27rpx; }.cloud:after { width: 72rpx; height: 68rpx; left: 68rpx; }
.cloud-one { left: 42rpx; }.cloud-two { right: 20rpx; top: 70rpx; transform: scale(.65); }
.mount { position: absolute; bottom: 78rpx; width: 420rpx; height: 210rpx; transform: rotate(45deg); border-radius: 40rpx; }
.mountain-back { left: -100rpx; background: #B3CAC5; opacity: .85; }.mountain-front { right: -150rpx; background: #92B7A9; opacity: .8; }
.river { position: absolute; height: 120rpx; width: 520rpx; left: 180rpx; bottom: -75rpx; background: rgba(162,205,215,.86); border-radius: 48% 52% 0 0; transform: rotate(-5deg); }
.road { position: absolute; height: 45rpx; width: 450rpx; left: -90rpx; bottom: 34rpx; background: #F8F2DE; border: 8rpx solid rgba(255,255,255,.56); border-radius: 50%; transform: rotate(-7deg); }
.school { position: absolute; bottom: 48rpx; left: 50%; transform: translateX(-50%); width: 168rpx; height: 94rpx; background: #F7E9CE; border: 7rpx solid #E4D4AF; border-radius: 5rpx; z-index: 2; }
.roof { position:absolute; left: -14rpx; top:-38rpx; width:0; height:0; border-left:98rpx solid transparent; border-right:98rpx solid transparent; border-bottom:42rpx solid #596F5D; }
.flag { position:absolute; top:-54rpx; left:79rpx; width:3rpx; height:35rpx; background:#6A786B; }.flag:after { content:''; position:absolute; left:3rpx; top:1rpx; width:19rpx; height:12rpx; background:#C84A3A; }
.windows { position:absolute; left:19rpx; top:31rpx; width:19rpx; height:25rpx; background:#9AC0C3; box-shadow: 34rpx 0 #9AC0C3,68rpx 0 #9AC0C3,102rpx 0 #9AC0C3; }
.city,.pearl,.people { display:none; }
.scene-school .school { transform:translateX(-50%) scale(1.22); bottom:39rpx; }.scene-school .mount { opacity:.38; }.scene-school .road { bottom:10rpx; }
.scene-changsha { background: linear-gradient(#D7E9F2 0%, #F7F2DC 66%, #B6D5D0 100%); }.scene-changsha .school { display:none; }.scene-changsha .mount { opacity:.16; }
.scene-changsha .city { display:flex; position:absolute; align-items:flex-end; gap:12rpx; bottom:61rpx; left:80rpx; z-index:2; }.scene-changsha .city view { display:block; width:37rpx; height:105rpx; background:#8BAEBA; border-radius:8rpx 8rpx 0 0; }.scene-changsha .city view:nth-child(2){height:165rpx;background:#80A5B1}.scene-changsha .city view:nth-child(3){height:128rpx;background:#B1C7C0}.scene-changsha .city view:nth-child(4){height:190rpx;background:#98B7C2}.scene-changsha .city view:nth-child(5){height:87rpx;background:#7D9EA9}
.scene-changsha .river { height:93rpx; width:840rpx; left:-80rpx; bottom:-40rpx; transform:rotate(0); }
.scene-shanghai { background: linear-gradient(#CFE8F0 0%, #EDF2E1 67%, #D7E1C7 100%); }.scene-shanghai .school { display:none; }.scene-shanghai .mount { opacity:.1; }
.scene-shanghai .city { display:flex; position:absolute; align-items:flex-end; gap:12rpx; bottom:65rpx; left:220rpx; z-index:2; }.scene-shanghai .city view { display:block; width:35rpx; height:145rpx; background:#8AA9B9; border-radius:6rpx 6rpx 0 0; }.scene-shanghai .city view:nth-child(2){height:210rpx}.scene-shanghai .city view:nth-child(3){height:112rpx}.scene-shanghai .city view:nth-child(4){height:170rpx}.scene-shanghai .city view:nth-child(5){height:130rpx}
.scene-shanghai .pearl { display:block; position:absolute; height:152rpx; width:8rpx; bottom:62rpx; left:143rpx; z-index:3; background:#9B6D72; }.scene-shanghai .pearl:before { content:''; position:absolute; top:43rpx; left:-32rpx; width:72rpx; height:72rpx; border-radius:50%; background:#BA8A91; }.scene-shanghai .pearl-ball { position:absolute; top:-17rpx; left:-18rpx; width:45rpx; height:45rpx; border-radius:50%; background:#C7989B; }
.scene-shanghai .people { display:flex; position:absolute; z-index:5; gap:18rpx; bottom:20rpx; left:45rpx; }.person { position:relative; width:35rpx; height:70rpx; border-radius:18rpx 18rpx 7rpx 7rpx; background:#C84A3A; }.person:before { content:''; position:absolute; top:-24rpx; left:6rpx; width:24rpx; height:24rpx; border-radius:50%; background:#E5B68D; }.person i { position:absolute; height:35rpx; width:8rpx; background:#E5B68D; top:19rpx; left:-6rpx; transform:rotate(33deg); }.person:nth-child(2){height:63rpx}.person:nth-child(3){height:76rpx}
.compact .mount { bottom:36rpx; transform:rotate(45deg) scale(.8); }.compact .school { bottom:32rpx; transform:translateX(-50%) scale(.75); }.compact .road { bottom:14rpx; }.compact .city { transform:scale(.7); transform-origin:bottom left; }.compact .pearl { transform:scale(.72); transform-origin:bottom left; }.compact .people { transform:scale(.7); transform-origin:bottom left; }
