/* 四等分底栏：水彩叶片为动态页选中态，其余为细灰线图标。 */
.custom-tabbar { position:fixed; z-index:100; right:0; bottom:0; left:0; display:flex; height:121rpx; padding:14rpx 14rpx calc(12rpx + env(safe-area-inset-bottom)); box-sizing:content-box; border-top:1rpx solid rgba(216,210,197,.82); background:rgba(255,253,248,.98); box-shadow:0 -7rpx 22rpx rgba(62,76,59,.035); }
.tabbar-item { position:relative; flex:1; min-width:0; text-align:center; }.nav-icon-image { display:block; width:67rpx; height:67rpx; margin:0 auto 5rpx; }.tabbar-label { color:#767977; font-family:"Songti SC",SimSun,serif; font-size:27rpx; line-height:1.1; letter-spacing:1rpx; }.tabbar-item.selected .tabbar-label { color:#254E3B; font-weight:700; }.tabbar-item:not(.selected) .nav-icon-fun { filter:grayscale(.7) opacity(.58); }.tabbar-item.selected .nav-icon-footprints,.tabbar-item.selected .nav-icon-friends,.tabbar-item.selected .nav-icon-profile { filter:brightness(.72) sepia(.4) saturate(1.7) hue-rotate(94deg); }.tabbar-badge { position:absolute; top:0; right:20rpx; z-index:2; min-width:28rpx; height:28rpx; padding:0 5rpx; box-sizing:border-box; border:3rpx solid #FFFCF6; border-radius:99rpx; color:#fff; background:#D9534F; font-size:17rpx; line-height:22rpx; }
