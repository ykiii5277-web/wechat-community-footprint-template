<view wx:if="{{friend && camp}}" class="page-shell friend-camp-page"><page-nav title="{{camp.name}}" subtitle="{{friend.name}}的足迹"></page-nav><view class="friend-camp-hero"><scene-banner scene="{{camp.scene}}"></scene-banner><view class="friend-camp-hero-copy"><view>{{camp.name}}</view><text>选择这段时光</text></view></view><view class="stage-picker"><view wx:for="{{stages}}" wx:key="id" class="stage-choice tap {{item.active ? 'active' : ''}}" data-id="{{item.id}}" bindtap="chooseStage"><image src="{{item.portrait}}" mode="aspectFill"></image><view wx:if="{{item.hasContent}}" class="stage-notice">!</view><view class="stage-label">{{item.name}}<text>{{item.active ? '✓' : '›'}}</text></view></view></view><view class="section-label">{{activeStage.name}}</view><view class="module-grid"><view wx:for="{{modules}}" wx:key="kind" class="module-card card tap" data-kind="{{item.kind}}" bindtap="openModule"><view class="module-icon {{item.tone}}">{{item.icon}}</view><view wx:if="{{item.count}}" class="module-count">{{item.count}}</view><view class="module-name">{{item.name}}</view><view class="module-hint">{{item.count ? item.count + ' 条可查看内容' : item.hint}}</view></view></view></view>
