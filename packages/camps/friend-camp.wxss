.friend-camp-page { padding-left:28rpx; padding-right:28rpx; padding-bottom:50rpx; }.friend-camp-hero { position:relative; height:255rpx; overflow:hidden; border-radius:25rpx; box-shadow:0 12rpx 30rpx rgba(37,69,52,.12); }.friend-camp-hero scene-banner { display:block; height:100%; }.friend-camp-hero-copy { position:absolute; right:0; bottom:0; left:0; padding:43rpx 22rpx 18rpx; color:#fff; background:linear-gradient(180deg,transparent,rgba(25,61,44,.72)); }.friend-camp-hero-copy view { font-family:"Songti SC",SimSun,serif; font-size:35rpx; font-weight:700; }.friend-camp-hero-copy text { display:block; margin-top:3rpx; font-size:20rpx; }.stage-picker { display:flex; gap:17rpx; margin-top:24rpx; }.stage-choice { position:relative; flex:1; min-width:0; padding-bottom:24rpx; }.stage-choice image { display:block; width:100%; height:255rpx; border:2rpx solid rgba(255,255,255,.85); border-radius:23rpx; box-shadow:0 9rpx 23rpx rgba(38,70,52,.11); }.stage-label { position:relative; z-index:2; display:flex; justify-content:space-between; align-items:center; min-height:65rpx; margin:-17rpx 12rpx 0; padding:0 14rpx 0 17rpx; border-radius:17rpx; color:#2D503E; background:#FFFDF7; box-shadow:0 7rpx 16rpx rgba(39,70,52,.12); font-family:"Songti SC",SimSun,serif; font-size:25rpx; font-weight:700; }.stage-choice.active image { border-color:#3D7558; }.stage-choice.active .stage-label { color:#fff; background:#3D7558; }.stage-notice { position:absolute; z-index:4; top:7rpx; right:7rpx; display:flex; align-items:center; justify-content:center; width:31rpx; height:31rpx; border:3rpx solid #fff; border-radius:50%; color:#fff; background:#D8584D; font-size:20rpx; font-weight:700; }.module-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:15rpx; margin-top:15rpx; }.module-card { position:relative; padding:25rpx 12rpx; text-align:center; }.module-icon { display:flex; align-items:center; justify-content:center; width:68rpx; height:68rpx; margin:0 auto 11rpx; border-radius:50%; color:#fff; font-size:32rpx; }.module-icon.green { background:#4C7B60; }.module-icon.gold { background:#C89438; }.module-icon.coral { background:#CC6857; }.module-icon.blue { background:#557F98; }.module-count { position:absolute; top:13rpx; right:13rpx; min-width:31rpx; height:31rpx; padding:0 4rpx; border-radius:99rpx; color:#fff; background:#D8584D; font-size:18rpx; line-height:31rpx; }.module-name { color:#254838; font-family:"Songti SC",SimSun,serif; font-size:29rpx; font-weight:700; }.module-hint { margin-top:4rpx; color:#809087; font-size:19rpx; }
