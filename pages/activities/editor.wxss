.activity-editor{min-height:100vh;padding-right:28rpx;padding-left:28rpx;background:#F8F5ED}.editor-card{padding:27rpx 25rpx 31rpx}.field-label{margin:13rpx 0 10rpx;color:#234D39;font-size:26rpx;font-weight:700}.field-label text{margin-left:8rpx;color:#8A998F;font-size:19rpx;font-weight:400}.text-input{box-sizing:border-box;height:72rpx;padding:0 17rpx;border-radius:15rpx;color:#263D32;background:#F5F4ED;font-size:26rpx}.image-picker{padding:48rpx 20rpx;border:2rpx dashed #BED1C5;border-radius:19rpx;color:#537564;background:#F3F7F1;font-size:25rpx;text-align:center}.image-picker text{display:block;margin-top:7rpx;color:#8B9990;font-size:20rpx}.image-plus{width:69rpx;height:69rpx;margin:0 auto 12rpx;border-radius:50%;color:#fff;background:#4B8A74;font-size:47rpx;line-height:65rpx}.picked-image{position:relative;overflow:hidden;height:340rpx;border-radius:20rpx}.picked-image image{display:block;width:100%;height:100%}.cover-actions{position:absolute;right:13rpx;bottom:13rpx;display:flex;gap:9rpx}.cover-action{padding:9rpx 17rpx;border-radius:99rpx;color:#fff;background:rgba(32,89,66,.88);font-size:21rpx}.cover-action.danger{background:rgba(157,61,49,.88)}
.editor-actions{display:flex;gap:18rpx;margin:30rpx 4rpx}.editor-actions .save-button{flex:1;margin:0}.delete-button{display:flex;flex:0 0 205rpx;height:82rpx;box-sizing:border-box;align-items:center;justify-content:center;margin:0;padding:0;border:1rpx solid #E8BDB5;border-radius:99rpx;color:#A64539;background:#F9E8E4;font-size:25rpx;font-weight:700;line-height:1}.delete-button::after{border:0}
