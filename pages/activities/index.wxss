.activities-page{min-height:100vh;padding-right:28rpx;padding-bottom:calc(145rpx + env(safe-area-inset-bottom));padding-left:28rpx;background:linear-gradient(180deg,#F7F4EC,#FBFAF5)}
.activity-intro{display:flex;gap:18rpx;align-items:center;padding:22rpx 24rpx;background:linear-gradient(135deg,#EDF5EF,#FFF9EB)}
.intro-icon{display:flex;flex:0 0 68rpx;align-items:center;justify-content:center;width:68rpx;height:68rpx;border-radius:22rpx;color:#fff;background:#3F8877;font-size:36rpx}
.intro-title{color:#234C3A;font-family:"Songti SC",SimSun,serif;font-size:28rpx;font-weight:700}.intro-copy{margin-top:5rpx;color:#708177;font-size:21rpx;line-height:1.55}
.activity-list{display:flex;flex-direction:column;gap:20rpx;margin-top:23rpx}.activity-card{position:relative;overflow:hidden;height:230rpx;border-radius:25rpx}.activity-cover{display:block;width:100%;height:100%}.activity-cover-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#376A56;background:linear-gradient(135deg,#DCEBE4,#F9EACD);font-family:"Songti SC",SimSun,serif}.activity-cover-empty view{font-size:61rpx}.activity-cover-empty text{margin-top:3rpx;font-size:24rpx}.activity-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(22,57,43,.7),rgba(22,57,43,.08) 75%)}.activity-copy{position:absolute;left:27rpx;bottom:28rpx;color:#fff;text-shadow:0 2rpx 8rpx rgba(0,0,0,.25)}.activity-name{font-family:"Songti SC",SimSun,serif;font-size:36rpx;font-weight:700}.activity-count{margin-top:7rpx;font-size:21rpx}.activity-arrow{position:absolute;right:24rpx;top:50%;color:#fff;font-family:sans-serif;font-size:59rpx;transform:translateY(-50%);text-shadow:0 2rpx 7rpx rgba(0,0,0,.25)}
.activity-edit{position:absolute;top:14rpx;right:14rpx;padding:8rpx 17rpx;border:1rpx solid rgba(255,255,255,.55);border-radius:99rpx;color:#fff;background:rgba(31,81,62,.8);font-size:20rpx;line-height:1.25}
.empty{margin-top:24rpx;padding:75rpx 30rpx;text-align:center}.empty-icon{width:80rpx;height:80rpx;margin:0 auto;border-radius:50%;color:#fff;background:#4A8A74;font-size:50rpx;line-height:76rpx}.empty-title{margin-top:20rpx;color:#284F3D;font-size:29rpx;font-weight:700}.empty-copy{margin-top:8rpx;color:#7B8981;font-size:22rpx;line-height:1.6}.bottom-space{height:50rpx}.add-activity{position:fixed;z-index:15;right:31rpx;bottom:calc(25rpx + env(safe-area-inset-bottom));left:31rpx;display:flex;height:76rpx;box-sizing:border-box;align-items:center;justify-content:center;padding:0;border:0;border-radius:99rpx;color:#fff;background:#246149;box-shadow:0 9rpx 22rpx rgba(34,93,70,.24);font-size:27rpx;font-weight:700;line-height:1;text-align:center}.add-activity::after{border:0}
