.folder-editor { padding-left:28rpx; padding-right:28rpx; }.editor-card { padding:25rpx 26rpx 30rpx; }.field-label { color:#1F513E; font-size:25rpx; font-weight:700; margin:16rpx 0 9rpx; }.field-note { margin:7rpx 3rpx 1rpx; color:#89958D; font-size:20rpx; }.text-input { height:68rpx; box-sizing:border-box; padding:0 14rpx; color:#20362C; background:#F8F6EF; border-radius:13rpx; font-size:27rpx; }.image-picker { padding:35rpx; text-align:center; color:#607A68; background:#F3F4EC; border:2rpx dashed #C9D7C9; border-radius:16rpx; font-size:24rpx; }.image-picker text { display:block; margin-top:6rpx; color:#8C978F; font-size:20rpx; }.image-plus { color:#C29443; font-size:42rpx; }.picked-image { position:relative; height:260rpx; overflow:hidden; border-radius:16rpx; }.picked-image image { width:100%; height:100%; display:block; }.cover-actions { position:absolute; right:12rpx; bottom:12rpx; display:flex; gap:9rpx; }.replace-image,.remove-cover { padding:7rpx 15rpx; border-radius:99rpx; color:#fff; background:rgba(31,81,62,.86); font-size:21rpx; }.remove-cover { background:rgba(156,61,48,.86); }.editor-actions { display:flex; gap:16rpx; margin:27rpx 5rpx; }.save-button,.delete-button { flex:1; }.delete-button { border:0; color:#B3473A; background:#F8E8E4; border-radius:99rpx; font-size:27rpx; line-height:2.7; }.delete-button::after { border:0; }
