.album-page{min-height:100vh;padding-right:28rpx;padding-bottom:170rpx;padding-left:28rpx}.album-intro{display:flex;gap:18rpx;align-items:center;padding:22rpx 24rpx;background:linear-gradient(135deg,#EDF5EF,#FFF9EB)}.intro-icon{display:flex;flex:0 0 68rpx;align-items:center;justify-content:center;width:68rpx;height:68rpx;border-radius:20rpx;color:#fff;background:#4C8A73;font-size:36rpx}.intro-title{color:#244D3A;font-size:27rpx;font-weight:700}.intro-copy{margin-top:5rpx;color:#718178;font-size:21rpx;line-height:1.55}
.folder-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;margin-top:22rpx}.folder-card{position:relative;overflow:hidden;height:235rpx}.folder-card image,.folder-cover{display:block;width:100%;height:100%}.folder-cover{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#47715D;background:linear-gradient(145deg,#E4EFE6,#F9EBCF)}.folder-cover view{font-size:56rpx}.folder-cover text{margin-top:5rpx;font-size:21rpx}.folder-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(24,55,42,.02) 35%,rgba(24,55,42,.75))}.folder-copy{position:absolute;right:45rpx;bottom:17rpx;left:16rpx;overflow:hidden;color:#fff;text-shadow:0 2rpx 7rpx rgba(0,0,0,.28)}.folder-copy view{overflow:hidden;font-size:27rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.folder-copy text{display:block;margin-top:3rpx;font-size:19rpx}.folder-arrow{position:absolute;right:15rpx;bottom:16rpx;color:#fff;font-size:42rpx;line-height:1}.folder-edit{position:absolute;top:11rpx;right:11rpx;padding:7rpx 13rpx;border-radius:99rpx;color:#fff;background:rgba(29,79,59,.8);font-size:19rpx}
.empty{margin-top:24rpx;padding:72rpx 25rpx;color:#87938B;font-size:21rpx;line-height:1.6;text-align:center}.empty-plus{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;margin:0 auto 16rpx;border-radius:50%;color:#fff;background:#4A8A74;font-size:47rpx}.empty-title{margin-bottom:5rpx;color:#315643;font-size:28rpx;font-weight:700}.bottom-space{height:40rpx}.new-album-button{position:fixed;z-index:10;right:55rpx;bottom:calc(25rpx + env(safe-area-inset-bottom));left:55rpx;display:flex;height:76rpx;box-sizing:border-box;align-items:center;justify-content:center;padding:0;border:0;border-radius:99rpx;color:#fff;background:#246149;box-shadow:0 9rpx 22rpx rgba(34,93,70,.24);font-size:27rpx;font-weight:700;line-height:1}.new-album-button::after{border:0}
.current-album{display:flex;align-items:center;justify-content:space-between;padding:20rpx 22rpx}.current-name{color:#274F3C;font-size:29rpx;font-weight:700}.current-count{margin-top:4rpx;color:#819087;font-size:20rpx}.edit-album{padding:9rpx 15rpx;border-radius:99rpx;color:#3C7057;background:#E7F0E8;font-size:20rpx;white-space:nowrap}.album-heading{display:flex;align-items:center;justify-content:space-between}.album-heading .section-label{flex:1}.selection-toggle{margin-top:18rpx;padding:7rpx 13rpx;border-radius:99rpx;color:#416F51;background:#E7F0E5;font-size:20rpx}.album-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;align-items:start}.photo-card{position:relative;overflow:hidden}.photo-card.lower{margin-top:35rpx}.album-grid.is-selecting .photo-card.lower{margin-top:0}.photo-card.is-selected{outline:5rpx solid #2F674E}.photo-art{position:relative;height:205rpx;overflow:hidden}.photo-art image{display:block;width:100%;height:100%}.photo-art scene-banner{display:block;height:100%}.photo-copy{min-height:46rpx;padding:12rpx 13rpx 14rpx}.photo-title{overflow:hidden;color:#20362C;font-size:25rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.photo-date,.photo-stats{margin-top:4rpx;color:#7C8B80;font-size:19rpx}.photo-stats{color:#9A7763}.corner-star,.multi-check{position:absolute;top:8rpx;right:10rpx}.corner-star{color:#FFF8E9;font-size:24rpx;text-shadow:0 1rpx 6rpx rgba(0,0,0,.25)}.multi-check{display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;box-sizing:border-box;border:3rpx solid #fff;border-radius:50%;color:#fff;background:rgba(31,81,62,.52);font-size:25rpx;font-weight:700}.photo-card.is-selected .multi-check{background:#2F674E}.album-tip{margin:26rpx 0;color:#94A097;font-size:20rpx;text-align:center}.fixed-album-bar{position:fixed;z-index:10;right:0;bottom:0;left:0;display:flex;gap:14rpx;padding:18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx);background:linear-gradient(180deg,rgba(248,245,237,0),#F8F5ED 30%)}.upload-button,.batch-delete,.batch-move{display:flex;flex:1;align-items:center;justify-content:center;padding:15rpx 0;border-radius:99rpx;font-size:24rpx;text-align:center}.single-action{padding-right:55rpx;padding-left:55rpx}.upload-button{color:#fff;background:#1F513E}.batch-delete{color:#A34337;background:#F9E6E1}.batch-move{color:#fff;background:#1F513E}
