<view wx:if="{{camp}}" class="page-shell camp-page">
  <page-nav title="{{camp.name}}"></page-nav>
  <view class="camp-atlas"><image class="camp-atlas-image" src="{{camp.heroImage}}" mode="aspectFill"></image><view class="atlas-shade"></view><view class="atlas-wash wash-one"></view><view class="atlas-wash wash-two"></view><view class="atlas-copy"><view class="atlas-eyebrow">同行足迹 · 成长记录</view><view class="atlas-title">{{camp.name}}</view></view><view class="atlas-route"><view class="route-dot active"></view><view class="route-line"></view><view class="route-dot"></view><view class="route-line"></view><view class="route-dot"></view></view></view>
  <view wx:if="{{hasStages}}" class="stage-section">
    <view class="section-label">选择这段时光</view>
    <!-- 人物选择区：营员、志愿者固定左右排列，名称标签位于人物下方。 -->
    <view class="stage-person-picker">
      <view wx:for="{{stages}}" wx:key="id" class="stage-person-choice tap stage-{{item.id}} {{item.active ? 'is-active' : ''}}" data-stage="{{item.id}}" bindtap="chooseStage">
        <view class="stage-person-portrait"><image src="{{item.portrait}}" mode="aspectFill"></image><view class="stage-person-shade"></view></view>
        <view wx:if="{{item.hasJourneyEdits}}" class="path-notice person-notice">!</view>
        <view class="stage-person-caption"><view class="stage-person-name">{{item.name}}</view><view class="stage-person-indicator">{{item.active ? '✓' : '›'}}</view></view>
      </view>
    </view>
    <view id="stage-modules" wx:if="{{activeStage}}" class="stage-content"><view class="stage-content-heading"><view><view class="section-label">{{stageTitle}}</view></view><view class="stage-current">当前</view></view><view class="module-grid"><view class="module-card card tap" bindtap="openCompanions"><view class="round green">♟</view><view wx:if="{{hasCompanions}}" class="module-notice">!</view><view class="action-name">伙伴</view><view class="muted">一起同行的人</view></view><view class="module-card card tap" bindtap="openAlbum"><view class="round gold">▧</view><view wx:if="{{hasAlbum}}" class="module-notice">!</view><view class="action-name">相册</view><view class="muted">留下的好时光</view></view><view class="module-card card tap" bindtap="openRecords"><view class="round coral">✦</view><view wx:if="{{hasRecords}}" class="module-notice">!</view><view class="action-name">记录</view><view class="muted">写下此刻感受</view></view><view class="module-card card tap" bindtap="openWorks"><view class="round blue">▤</view><view wx:if="{{hasWorks}}" class="module-notice">!</view><view class="action-name">作品</view><view class="muted">收好创作与文件</view></view></view></view>
  </view>
  <view wx:else class="direct-section"><view class="section-label">留在这里的故事</view><view class="actions card"><view class="action tap" bindtap="openCompanions"><view class="action-icon people-icon">♟</view><view wx:if="{{hasCompanions}}" class="path-notice action-notice">!</view><view><view class="action-name">伙伴</view><view class="muted">认识一起同行的伙伴</view></view><view class="stage-arrow">›</view></view><view class="hairline"></view><view class="action tap" bindtap="openAlbum"><view class="action-icon album-icon">▧</view><view wx:if="{{hasAlbum}}" class="path-notice action-notice">!</view><view><view class="action-name">相册</view><view class="muted">翻看珍贵的活动瞬间</view></view><view class="stage-arrow">›</view></view><view class="hairline"></view><view class="action tap" bindtap="openRecords"><view class="action-icon record-icon">✦</view><view wx:if="{{hasRecords}}" class="path-notice action-notice">!</view><view><view class="action-name">记录</view><view class="muted">写下留在这里的感受</view></view><view class="stage-arrow">›</view></view><view class="hairline"></view><view class="action tap" bindtap="openWorks"><view class="action-icon work-icon">▤</view><view wx:if="{{hasWorks}}" class="path-notice action-notice">!</view><view><view class="action-name">作品</view><view class="muted">收好创作与文件</view></view><view class="stage-arrow">›</view></view></view></view>
  <view class="bottom-space"></view>
</view>
