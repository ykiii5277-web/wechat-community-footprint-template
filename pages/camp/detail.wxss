.camp-page { padding-left:0; padding-right:0; padding-bottom:55rpx; background:linear-gradient(180deg,#F8F5ED 0,#F8F5ED 48%,#F4F1E8 100%); }.camp-page page-nav { display:block; padding:0 28rpx; }.camp-atlas { position:relative; height:365rpx; margin:0 28rpx; overflow:hidden; border-radius:30rpx; background:#5F8571; box-shadow:0 18rpx 40rpx rgba(27,64,47,.18); }.camp-atlas-image { display:block; width:100%; height:100%; transform:scale(1.04); }.atlas-shade { position:absolute; inset:0; background:linear-gradient(135deg,rgba(20,61,44,.73),rgba(42,91,71,.26) 55%,rgba(246,234,205,.14)); }.atlas-wash { position:absolute; border-radius:50%; background:rgba(244,242,222,.22); filter:blur(2rpx); }.wash-one { width:420rpx; height:200rpx; right:-120rpx; bottom:-95rpx; }.wash-two { width:210rpx; height:130rpx; left:-85rpx; top:-55rpx; }.atlas-copy { position:absolute; z-index:2; top:39rpx; right:32rpx; left:32rpx; color:#fff; }.atlas-eyebrow { display:inline-block; padding:5rpx 13rpx; border:1rpx solid rgba(255,255,255,.45); border-radius:99rpx; background:rgba(20,57,42,.25); font-size:19rpx; letter-spacing:1rpx; }.atlas-title { margin-top:14rpx; font-family:"Songti SC",SimSun,serif; font-size:52rpx; font-weight:700; letter-spacing:2rpx; text-shadow:0 3rpx 12rpx rgba(0,0,0,.22); }.atlas-meta { margin-top:8rpx; color:rgba(255,255,255,.9); font-size:21rpx; }.atlas-route { position:absolute; z-index:2; right:33rpx; bottom:33rpx; left:33rpx; display:flex; align-items:center; }.route-dot { width:15rpx; height:15rpx; box-sizing:border-box; border:3rpx solid rgba(255,255,255,.75); border-radius:50%; background:rgba(255,255,255,.18); }.route-dot.active { border-color:#FFF7D9; background:#E9B94A; box-shadow:0 0 0 7rpx rgba(255,241,200,.2); }.route-line { flex:1; height:2rpx; background:linear-gradient(90deg,rgba(255,255,255,.85),rgba(255,255,255,.22)); }.intro { margin:-34rpx 42rpx 0; position:relative; z-index:3; padding:25rpx 28rpx; border:1rpx solid rgba(255,255,255,.88); box-shadow:0 12rpx 30rpx rgba(40,74,55,.11); }.intro-kicker { color:#1F513E; font-family:"Songti SC",SimSun,serif; font-weight:700; font-size:27rpx; }.intro-text { margin-top:10rpx; font-size:25rpx; color:#52675A; line-height:1.8; }.stage-section,.direct-section { padding:0 28rpx; }.stage-section > .section-label { margin-top:34rpx; }.stage-card { position:relative; display:flex; align-items:center; min-height:146rpx; margin-bottom:17rpx; padding:12rpx; border:1rpx solid rgba(66,105,82,.08); box-shadow:0 9rpx 22rpx rgba(39,70,52,.07); }.stage-card.is-active { border-color:rgba(47,103,78,.5); outline:0; box-shadow:0 12rpx 28rpx rgba(31,81,62,.17); }.stage-camper { background:linear-gradient(110deg,#FFFCF6,#EDF4EA); }.stage-volunteer { background:linear-gradient(110deg,#FFFCF6,#FCF0D9); }.stage-illustration { position:relative; width:126rpx; height:126rpx; flex:0 0 126rpx; overflow:hidden; border-radius:18rpx; background:#D9EAE9; }.stage-illustration image { display:block; width:100%; height:100%; }.stage-art-shade { position:absolute; inset:0; background:linear-gradient(145deg,rgba(23,59,42,.04),rgba(26,65,47,.62)); }.stage-illustration text { position:absolute; right:12rpx; bottom:6rpx; color:#fff; font-family:"Songti SC",SimSun,serif; font-size:35rpx; font-weight:700; text-shadow:0 2rpx 7rpx rgba(0,0,0,.25); }.stage-copy { margin-left:23rpx; flex:1; }.stage-name,.action-name { color:#20362C; font-size:32rpx; font-family:"Songti SC",SimSun,serif; font-weight:700; }.stage-copy .muted { margin-top:5rpx; font-size:23rpx; }.stage-arrow { color:#1F513E; font-size:44rpx; line-height:1; margin:0 10rpx 0 15rpx; }.stage-content { margin-top:34rpx; padding:24rpx 18rpx 20rpx; border-radius:26rpx; background:linear-gradient(155deg,rgba(238,244,235,.92),rgba(255,252,246,.95)); box-shadow:inset 0 0 0 1rpx rgba(255,255,255,.8),0 10rpx 26rpx rgba(39,70,52,.06); }.stage-content-heading { display:flex; align-items:flex-end; justify-content:space-between; padding:0 9rpx; }.stage-content-heading .section-label { margin:0; }.stage-subtitle { margin-top:3rpx; color:#718078; font-size:21rpx; }.stage-current { padding:5rpx 13rpx; border-radius:99rpx; color:#fff; background:#507962; font-size:19rpx; }.stage-intro { margin:15rpx 8rpx 22rpx; padding:24rpx 27rpx; color:#52675A; font-size:24rpx; line-height:1.8; box-shadow:0 7rpx 18rpx rgba(39,70,52,.06); }.module-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:15rpx; }.module-card { position:relative; min-height:192rpx; box-sizing:border-box; padding:27rpx 11rpx; border:1rpx solid rgba(80,110,90,.08); box-shadow:0 7rpx 18rpx rgba(39,70,52,.05); text-align:center; }.round { margin:0 auto 14rpx; width:76rpx; height:76rpx; border-radius:50%; display:flex; justify-content:center; align-items:center; color:#fff; box-shadow:0 7rpx 13rpx rgba(40,70,52,.16); font-size:37rpx; }.green { background:linear-gradient(135deg,#315F49,#619277); }.gold { background:linear-gradient(135deg,#B77A24,#D6AB50); }.coral { background:linear-gradient(135deg,#B95043,#DD836B); }.blue { background:linear-gradient(135deg,#426D87,#6EA0B4); }.module-card .action-name { font-size:30rpx; }.module-card .muted { font-size:21rpx; margin-top:4rpx; }.module-notice { position:absolute; top:15rpx; right:15rpx; display:flex; align-items:center; justify-content:center; width:31rpx; height:31rpx; box-sizing:border-box; border:3rpx solid #fff; border-radius:50%; color:#fff; background:#D9534F; box-shadow:0 3rpx 8rpx rgba(122,45,41,.28); font-size:22rpx; font-weight:700; }.actions { padding:0 26rpx; }.action { position:relative; display:flex; align-items:center; padding:25rpx 0; }.action-icon { width:76rpx; height:76rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; font-size:38rpx; margin-right:22rpx; }.people-icon { background:#3F7258; }.album-icon { background:#C4933E; }.record-icon { background:#D66A55; }.work-icon { background:#4D7594; }.action .muted { font-size:22rpx; margin-top:3rpx; }.action .stage-arrow { margin-left:auto; }
/* 第二层页面的红点与首页同义：这里已经有用户自己编辑过的内容。 */
.path-notice { position:absolute; z-index:3; display:flex; align-items:center; justify-content:center; width:31rpx; height:31rpx; box-sizing:border-box; border:3rpx solid #fff; border-radius:50%; color:#fff; background:#D9534F; box-shadow:0 3rpx 8rpx rgba(122,45,41,.28); font-size:22rpx; font-weight:700; }.stage-notice { top:11rpx; left:113rpx; }.action-notice { top:17rpx; left:73rpx; }

/* 阶段入口采用“人物在左、文字在右”的选择卡；选中时只加强边框与光影，不遮挡插画。 */
.stage-card { min-height:152rpx; padding:13rpx; overflow:hidden; border-radius:23rpx; border-color:rgba(66,105,82,.12); }
.stage-card::after { content:''; position:absolute; z-index:0; top:-45rpx; right:-70rpx; width:245rpx; height:245rpx; border-radius:50%; background:rgba(255,255,255,.34); }
.stage-card.is-active { border:2rpx solid rgba(47,103,78,.62); box-shadow:0 13rpx 30rpx rgba(31,81,62,.17); }
.stage-card.is-active::before { content:''; position:absolute; z-index:2; top:28rpx; right:0; width:7rpx; height:96rpx; border-radius:8rpx 0 0 8rpx; background:#40745A; }
.stage-illustration { z-index:1; width:130rpx; height:130rpx; flex-basis:130rpx; border-radius:18rpx; box-shadow:0 6rpx 15rpx rgba(39,70,52,.14); }
.stage-art-shade { background:linear-gradient(145deg,rgba(23,59,42,.02),rgba(26,65,47,.43)); }
.stage-copy { position:relative; z-index:1; margin-left:25rpx; }
.stage-name { letter-spacing:1rpx; }
.stage-copy .muted { max-width:250rpx; color:#63776A; }
.stage-card .stage-arrow { position:relative; z-index:1; display:flex; align-items:center; justify-content:center; width:42rpx; height:42rpx; margin-right:7rpx; border-radius:50%; color:#1F513E; background:rgba(255,255,255,.56); font-size:38rpx; }
.stage-notice { z-index:4; top:8rpx; left:116rpx; }

/* 移除阶段文字介绍卡后，保留标题和功能入口之间舒适的呼吸距离。 */
.stage-content .module-grid { margin-top:22rpx; }

/* 两名角色固定左右并列：图片负责人物视觉，底部浮层只放阶段名称，不遮住人物主体。 */
.stage-person-picker { display:flex; gap:18rpx; align-items:flex-start; margin:12rpx 0 40rpx; }
.stage-person-choice { position:relative; flex:1; min-width:0; padding-bottom:28rpx; }
.stage-person-portrait { position:relative; height:308rpx; overflow:hidden; border:2rpx solid rgba(255,255,255,.82); border-radius:28rpx; background:#E5EBDD; box-shadow:0 12rpx 26rpx rgba(35,72,52,.12); }
.stage-person-portrait image { display:block; width:100%; height:100%; transform:scale(1.02); }
.stage-person-shade { position:absolute; right:0; bottom:0; left:0; height:42%; background:linear-gradient(180deg,rgba(24,51,39,0),rgba(24,51,39,.23)); }
.stage-person-caption { position:relative; z-index:2; display:flex; align-items:center; justify-content:space-between; min-height:72rpx; margin:-18rpx 14rpx 0; padding:0 16rpx 0 20rpx; border:1rpx solid rgba(45,92,68,.13); border-radius:19rpx; background:rgba(255,253,247,.97); box-shadow:0 8rpx 18rpx rgba(38,68,51,.12); }
.stage-person-name { color:#284938; font-family:"Songti SC",SimSun,serif; font-size:27rpx; font-weight:700; white-space:nowrap; }
.stage-person-indicator { display:flex; align-items:center; justify-content:center; width:34rpx; height:34rpx; border-radius:50%; color:#316149; background:#EDF5ED; font-size:26rpx; font-weight:700; }
.stage-person-choice.is-active .stage-person-portrait { border-color:#4C8064; box-shadow:0 14rpx 30rpx rgba(31,81,62,.23); }
.stage-person-choice.is-active .stage-person-caption { border-color:#3E7358; background:#3F7258; box-shadow:0 9rpx 20rpx rgba(31,81,62,.2); }
.stage-person-choice.is-active .stage-person-name { color:#fff; }
.stage-person-choice.is-active .stage-person-indicator { color:#3F7258; background:#FFF9E8; }
.stage-person-choice.stage-volunteer .stage-person-portrait { background:#F1E5CD; }
.person-notice { top:7rpx; right:7rpx; left:auto; z-index:4; }
