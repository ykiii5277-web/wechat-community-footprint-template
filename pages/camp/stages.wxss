.stage-page { padding-left:0; padding-right:0; }.stage-page page-nav { display:block; padding:0 28rpx; }.stage-page scene-banner { display:block; margin:0 28rpx; }.stage-intro { margin:-21rpx 42rpx 24rpx; position:relative; z-index:2; padding:9rpx 27rpx 27rpx; color:#52675A; line-height:1.8; }.stage-intro .section-label { margin:18rpx 0 8rpx; }.module-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:20rpx; padding:0 28rpx; }.module-card { position:relative; min-height:192rpx; box-sizing:border-box; padding:30rpx 11rpx; text-align:center; }.round { margin:0 auto 14rpx; width:76rpx; height:76rpx; border-radius:50%; display:flex; justify-content:center; align-items:center; color:#fff; font-size:37rpx; }.green { background:#3F7258; }.gold { background:#C4933E; }.coral { background:#D66A55; }.blue { background:#4D7594; }.module-card .action-name { font-size:30rpx; }.module-card .muted { font-size:21rpx; margin-top:4rpx; }.module-notice { position:absolute; top:15rpx; right:15rpx; display:flex; align-items:center; justify-content:center; width:31rpx; height:31rpx; box-sizing:border-box; border:3rpx solid #fff; border-radius:50%; color:#fff; background:#D9534F; box-shadow:0 3rpx 8rpx rgba(122,45,41,.28); font-size:22rpx; font-weight:700; }
