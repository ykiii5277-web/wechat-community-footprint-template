<view wx:if="{{camp}}" class="page-shell subcamps-page"><page-nav title="服务阶段" subtitle="{{camp.name}}"></page-nav><view class="page-hint">在每一所学校，留下不同的陪伴。</view><view wx:for="{{subcamps}}" wx:key="id" class="subcamp card tap" data-id="{{item.id}}" bindtap="open"><scene-banner scene="{{camp.scene}}" compact="{{true}}"></scene-banner><view class="subcamp-copy"><view class="subcamp-name">{{item.name}}</view><view class="date-line">⌖ {{item.location}}　·　{{item.dateRange}}</view><view class="quick-links"><view class="quick-link green-link" catchtap="quick" data-id="{{item.id}}" data-type="companions">♟ 伙伴</view><view class="quick-link gold-link" catchtap="quick" data-id="{{item.id}}" data-type="album">▧ 相册</view></view></view><view class="subcamp-arrow">›</view></view><view wx:if="{{!subcamps.length}}" class="empty">暂时还没有这段经历的记录。</view></view>
