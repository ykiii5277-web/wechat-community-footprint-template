.community-detail { padding-right:28rpx; padding-left:28rpx; }
.community-card { overflow:hidden; }
.community-image { height:500rpx; background:#F2F0E7; }
.community-image image { display:block; width:100%; height:100%; }
.community-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:6rpx; padding:8rpx; background:#F2F0E7; }
.community-grid image { display:block; width:100%; height:210rpx; }
.community-placeholder { display:flex; align-items:center; justify-content:center; height:250rpx; color:#D0B270; background:#F5F2E7; font-size:95rpx; }
.community-copy { padding:25rpx; }
.community-title { color:#20362C; font-family:"Songti SC",SimSun,serif; font-size:38rpx; font-weight:700; }
.community-owner { margin-top:9rpx; color:#708277; font-size:22rpx; }
.community-location { margin-top:9rpx; color:#667B70; font-size:22rpx; }
.community-body { margin-top:20rpx; color:#50665A; font-size:26rpx; line-height:1.8; white-space:pre-wrap; }
.community-story { margin-top:14rpx; color:#708177; font-size:23rpx; line-height:1.7; white-space:pre-wrap; }
.community-file { margin-top:17rpx; padding:12rpx 15rpx; border-radius:12rpx; color:#456175; background:#EAF0F2; font-size:23rpx; }
.community-meta { margin-top:20rpx; color:#7C8B80; font-size:21rpx; }
.community-status { display:flex; align-items:center; gap:10rpx; margin-top:12rpx; }.community-public,.community-author-uid { display:inline-block; padding:4rpx 12rpx; border-radius:99rpx; font-size:19rpx; }.community-public { color:#557260; background:#E8F0E6; }.community-author-uid { color:#786143; background:#F8F0DF; }
.community-actions { display:flex; gap:15rpx; margin:22rpx 4rpx; }.community-like,.community-edit,.community-report { padding:16rpx 0; border-radius:99rpx; font-size:25rpx; text-align:center; }.community-like { flex:1; color:#fff; background:#1F513E; }.community-edit { flex:0 0 190rpx; color:#315F49; background:#E8F0E6; }.community-report { flex:0 0 112rpx; color:#A16B32; background:#F9EEDB; }
.community-comment-list { gap:0; }.community-comment-thread { padding:11rpx 0 15rpx; border-bottom:1rpx solid #E8ECE3; }.community-comment-thread:last-child { border-bottom:0; }.community-thread-toggle { display:inline-flex; align-items:center; gap:6rpx; margin:5rpx 0 2rpx 73rpx; padding:8rpx 13rpx; border-radius:99rpx; color:#527661; background:#EEF4EC; font-size:20rpx; }.community-thread-toggle text { color:#2F6A4E; font-size:22rpx; line-height:1; }.community-replies { margin:10rpx 0 0 73rpx; padding:5rpx 13rpx; border-left:3rpx solid #CFE0D1; border-radius:0 13rpx 13rpx 0; background:#F7F9F4; }.community-reply-item { display:flex; align-items:flex-start; padding:14rpx 0; border-bottom:1rpx solid #E5ECE2; }.community-reply-item:last-child { border-bottom:0; }.community-reply-avatar { width:47rpx; height:47rpx; flex-basis:47rpx; font-size:20rpx; }.community-reply-item .community-comment-copy text { font-size:22rpx; }.community-reply-item .community-comment-actions { margin-left:7rpx; }
.community-comments { margin-bottom:30rpx; padding:23rpx; }.comment-heading { color:#264B39; font-family:"Songti SC",SimSun,serif; font-size:30rpx; font-weight:700; }.community-comment-list { display:flex; flex-direction:column; gap:19rpx; margin-top:20rpx; }.community-comment { display:flex; align-items:flex-start; }.community-comment-avatar { display:flex; flex:0 0 auto; align-items:center; justify-content:center; width:60rpx; height:60rpx; margin-right:13rpx; overflow:hidden; border-radius:50%; color:#fff; background:#648070; font-size:24rpx; }.community-comment-avatar image { width:100%; height:100%; transform-origin:center; }.community-comment-copy { flex:1; min-width:0; color:#315243; font-size:23rpx; font-weight:700; }.community-comment-copy text { display:block; margin-top:4rpx; color:#58695F; font-size:24rpx; font-weight:400; line-height:1.55; }.community-comment-copy .community-comment-date { color:#94A097; font-size:18rpx; }.community-comment-copy .community-reply-to { display:inline-block; margin-right:7rpx; color:#557A64; font-size:20rpx; }.community-comment-actions { display:flex; flex:0 0 auto; align-items:center; margin-left:8rpx; color:#A06A1B; text-align:right; }.community-comment-like { display:flex; align-items:center; justify-content:center; min-width:82rpx; min-height:64rpx; padding:7rpx 13rpx; box-sizing:border-box; border-radius:99rpx; color:#A06A1B; background:#FFF4E3; font-size:29rpx; font-weight:700; white-space:nowrap; }.community-no-comment { margin-top:18rpx; color:#91A096; font-size:22rpx; }.reply-banner { display:flex; justify-content:space-between; margin-top:18rpx; padding:10rpx 13rpx; border-radius:10rpx; color:#567262; background:#EDF3E9; font-size:21rpx; }.reply-banner text { color:#997044; }.community-composer { display:flex; gap:11rpx; margin-top:22rpx; }.community-composer input { flex:1; height:64rpx; min-width:0; padding:0 14rpx; border-radius:12rpx; color:#20362C; background:#F5F3EB; font-size:24rpx; }.community-composer view { padding:0 22rpx; border-radius:12rpx; color:#fff; background:#1F513E; font-size:23rpx; line-height:64rpx; }
