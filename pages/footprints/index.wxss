.footprints-scroll { height:100vh; background:#F8F5ED; }
.footprints-page { min-height:100%; padding:0 26rpx calc(230rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:#F8F5ED; }
.footprints-page.is-guided { padding-bottom:calc(530rpx + env(safe-area-inset-bottom)); }
.topline { display:flex; justify-content:space-between; align-items:center; margin: 9rpx 4rpx 20rpx; }.profile-dot { width:64rpx; height:64rpx; line-height:64rpx; text-align:center; border-radius:50%; color:#fff; font-weight:700; background:linear-gradient(135deg,#315F51,#A7C8C0); box-shadow:0 5rpx 13rpx rgba(31,81,62,.2); }.other-footprints-link { position:absolute; z-index:8; top:18rpx; right:18rpx; display:flex; align-items:center; gap:5rpx; padding:11rpx 14rpx 11rpx 12rpx; border:1rpx solid rgba(53,99,76,.18); border-radius:99rpx; color:#28523E; background:rgba(255,253,247,.92); box-shadow:0 5rpx 13rpx rgba(39,70,52,.12); font-size:21rpx; font-weight:700; white-space:nowrap; }.other-route-icon { display:flex; align-items:center; justify-content:center; width:25rpx; height:25rpx; border-radius:50%; color:#fff; background:#4B8062; font-size:20rpx; line-height:1; }
.other-route-notice { position:absolute; z-index:2; top:-12rpx; right:-9rpx; display:flex; align-items:center; justify-content:center; width:31rpx; height:31rpx; border:3rpx solid #fff; border-radius:50%; color:#fff; background:#D9534F; box-shadow:0 3rpx 8rpx rgba(122,45,41,.28); font-size:22rpx; font-weight:700; }
.journey-map { position:relative; height:0; padding-bottom:177.68%; overflow:hidden; border-radius:26rpx; background:#E7ECE3; box-shadow:0 10rpx 32rpx rgba(39,70,52,.09); }
.journey-map-image { position:absolute; top:0; left:0; display:block; width:100%; height:100%; }

/*
 * 图钉和标签的坐标按足迹地图上的路径依次排布。
 * 乡村、夏令营、志愿服务的位置对应界面标注；社会实践保持原位。
 */
.journey-stop { position:absolute; z-index:4; width:250rpx; }
.stop-rural { top:14%; left:22rpx; }
.stop-summer { top:45%; left:340rpx; }
.stop-changsha { top:66%; left:16rpx; }
.stop-shanghai { top:92.5%; left:370rpx; }

/* 图钉只标识路径节点，文字按钮从它的右边开始。 */
.map-pin { position:absolute; width:58rpx; height:58rpx; line-height:58rpx; text-align:center; border-radius:50% 50% 50% 0; transform:rotate(-45deg); color:#fff; box-shadow:0 6rpx 15rpx rgba(31,81,62,.3); }
.map-pin text { display:block; transform:rotate(45deg); font-size:26rpx; font-weight:700; }
.pin-rural { background:#2F674E; }.pin-school { background:#D49A31; }.pin-changsha { background:#4794A7; }.pin-shanghai { background:#3A795B; }

/* 红色感叹号不是报错，而是提示该路径下已有用户编辑的内容。 */
.path-notice { position:absolute; z-index:2; top:-12rpx; left:42rpx; display:flex; align-items:center; justify-content:center; width:31rpx; height:31rpx; border:3rpx solid #fff; border-radius:50%; color:#fff; background:#D9534F; box-shadow:0 3rpx 8rpx rgba(122,45,41,.28); font-size:22rpx; font-weight:700; }

/* 缩窄标签，保证四个入口都能完整放入地图容器。 */
.stop-label { position:absolute; left:66rpx; top:0; width:194rpx; box-sizing:border-box; padding:11rpx 12rpx; border-radius:99rpx; background:rgba(255,252,246,.96); color:#20362C; box-shadow:0 5rpx 13rpx rgba(39,70,52,.16); font-size:23rpx; font-weight:700; white-space:nowrap; }
.chevron { float:right; margin-left:7rpx; color:#1F513E; font-size:30rpx; line-height:26rpx; }
.map-finish { position:absolute; z-index:4; bottom:20rpx; left:0; right:0; text-align:center; color:#486354; font-size:21rpx; text-shadow:0 1rpx 5rpx rgba(255,255,255,.9); }

/* 首次引导采用自定义卡片，因此标题内的品牌名可以单独加粗。 */
.profile-guide-mask { position:fixed; z-index:100; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; padding:48rpx; box-sizing:border-box; background:rgba(20,47,37,.48); }.profile-guide-card { width:100%; max-width:580rpx; padding:43rpx 38rpx 33rpx; box-sizing:border-box; border:1rpx solid rgba(255,255,255,.8); border-radius:31rpx; background:#FFFCF6; box-shadow:0 18rpx 55rpx rgba(13,42,31,.3); text-align:center; }.profile-guide-leaf { display:flex; align-items:center; justify-content:center; width:70rpx; height:70rpx; margin:0 auto 15rpx; border-radius:50%; color:#fff; background:#527D60; font-size:33rpx; }.profile-guide-title { color:#355E46; font-family:"Songti SC",SimSun,serif; font-size:35rpx; }.profile-guide-title text { margin-left:7rpx; color:#1F513E; font-size:40rpx; font-weight:800; }.profile-guide-copy { margin-top:25rpx; color:#435D4E; font-size:25rpx; line-height:1.75; text-align:left; }.profile-guide-note { margin-top:9rpx; color:#849188; font-size:20rpx; line-height:1.65; text-align:left; }.profile-guide-actions { display:flex; gap:16rpx; margin-top:31rpx; }.guide-skip,.guide-confirm { flex:1; padding:16rpx 0; border-radius:99rpx; font-size:26rpx; }.guide-skip { color:#567061; background:#E8EEE5; }.guide-confirm { color:#fff; background:#1F513E; box-shadow:0 7rpx 16rpx rgba(31,81,62,.22); }
