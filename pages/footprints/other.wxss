.other-footprints-page { min-height:100vh; padding-bottom:176rpx; box-sizing:border-box; background:#F8F5ED; }.other-safe { height:env(safe-area-inset-top); min-height:24rpx; }.other-page-header { display:flex; align-items:center; height:92rpx; padding:0 26rpx; }.other-back,.other-page-placeholder { flex:0 0 78rpx; width:78rpx; }.other-back { color:#1F513E; font-family:sans-serif; font-size:68rpx; line-height:65rpx; }.other-page-title { flex:1; overflow:hidden; color:#1F513E; font-family:"Songti SC",SimSun,serif; font-size:37rpx; font-weight:700; letter-spacing:1rpx; text-align:center; white-space:nowrap; text-overflow:ellipsis; }.other-intro { padding:3rpx 40rpx 24rpx; }.intro-title { color:#244D3A; font-family:"Songti SC",SimSun,serif; font-size:31rpx; font-weight:700; letter-spacing:1rpx; }.intro-note { margin-top:7rpx; color:#788B80; font-size:22rpx; }.other-map { position:relative; height:1090rpx; margin:0 26rpx; overflow:hidden; border-radius:31rpx; background:#DDE9EC; box-shadow:0 16rpx 38rpx rgba(35,68,54,.14); }.other-map-image { display:block; width:100%; height:100%; }.map-mist { position:absolute; left:0; right:0; height:155rpx; background:linear-gradient(180deg,rgba(255,253,248,.84),rgba(255,253,248,0)); pointer-events:none; }.mist-one { top:302rpx; }.mist-two { top:706rpx; transform:rotate(180deg); opacity:.65; }.other-stop { position:absolute; z-index:2; display:flex; align-items:center; }.stop-winter { top:166rpx; left:36rpx; }.stop-spark { top:486rpx; right:22rpx; }.stop-other { top:856rpx; left:35rpx; }.other-pin { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; box-sizing:border-box; border:7rpx solid rgba(255,255,255,.94); border-radius:50% 50% 50% 5rpx; transform:rotate(-45deg); color:#fff; box-shadow:0 7rpx 16rpx rgba(23,62,47,.25); font-size:34rpx; font-family:serif; line-height:1; }.pin-symbol { display:block; transform:rotate(45deg); }.pin-winter { background:#2E6870; }.pin-spark { background:#D2942E; }.pin-other { background:#3E7958; }.other-label { min-width:173rpx; margin-left:18rpx; padding:15rpx 20rpx; border-radius:99rpx; color:#203C2E; background:rgba(255,253,248,.96); box-shadow:0 6rpx 16rpx rgba(37,65,53,.14); font-family:"Songti SC",SimSun,serif; font-size:31rpx; font-weight:700; }.other-label text { float:right; margin-left:20rpx; color:#4C725C; font-family:sans-serif; font-size:39rpx; line-height:27rpx; }.other-tip { margin:23rpx 42rpx 0; color:#6D8174; font-size:21rpx; line-height:1.7; text-align:center; }.other-tabbar { position:fixed; z-index:20; right:0; bottom:0; left:0; display:flex; height:121rpx; padding:14rpx 14rpx calc(12rpx + env(safe-area-inset-bottom)); box-sizing:content-box; border-top:1rpx solid rgba(216,210,197,.82); background:rgba(255,253,248,.98); box-shadow:0 -7rpx 22rpx rgba(62,76,59,.035); }.other-tab { flex:1; color:#767977; font-family:"Songti SC",SimSun,serif; font-size:27rpx; line-height:1.1; text-align:center; }.other-tab image { display:block; width:67rpx; height:67rpx; margin:0 auto 5rpx; }.other-tab:first-child image { filter:grayscale(.7) opacity(.58); }.other-tab.selected { color:#254E3B; font-weight:700; }.other-tab.selected image { filter:brightness(.72) sepia(.4) saturate(1.7) hue-rotate(94deg); }
