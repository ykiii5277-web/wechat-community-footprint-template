.friend-activities-page{min-height:100vh;padding-right:28rpx;padding-bottom:50rpx;padding-left:28rpx}.activity-guide{display:flex;gap:17rpx;align-items:center;padding:21rpx 23rpx;background:linear-gradient(135deg,#EDF5EF,#FFF9EB)}.guide-icon{display:flex;flex:0 0 66rpx;align-items:center;justify-content:center;width:66rpx;height:66rpx;border-radius:20rpx;color:#fff;background:#4A876F;font-size:35rpx}.guide-title{color:#28513E;font-size:27rpx;font-weight:700}.guide-copy{margin-top:4rpx;color:#75857C;font-size:20rpx;line-height:1.5}.activity-list{display:flex;flex-direction:column;gap:19rpx;margin-top:21rpx}.activity-card{position:relative;overflow:hidden;height:225rpx}.activity-card image,.activity-cover-empty{display:block;width:100%;height:100%}.activity-cover-empty{display:flex;align-items:center;justify-content:center;color:#39705A;background:linear-gradient(135deg,#DDECE5,#F5E8C9);font-size:65rpx}.activity-shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(24,60,45,.72),rgba(24,60,45,.08) 78%)}.activity-copy{position:absolute;right:55rpx;bottom:24rpx;left:23rpx;color:#fff;text-shadow:0 2rpx 8rpx rgba(0,0,0,.25)}.activity-copy view{overflow:hidden;font-size:33rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.activity-copy text{display:block;margin-top:5rpx;font-size:20rpx}.activity-arrow{position:absolute;right:22rpx;top:50%;color:#fff;font-size:58rpx;transform:translateY(-50%)}.empty{margin-top:23rpx;padding:75rpx 26rpx;color:#839087;font-size:22rpx;text-align:center}
