.friend-albums-page{min-height:100vh;padding-right:28rpx;padding-bottom:55rpx;padding-left:28rpx}.album-guide{display:flex;gap:17rpx;align-items:center;padding:21rpx 23rpx;background:linear-gradient(135deg,#EDF5EF,#FFF9EB)}.guide-icon{display:flex;flex:0 0 66rpx;align-items:center;justify-content:center;width:66rpx;height:66rpx;border-radius:20rpx;color:#fff;background:#4A876F;font-size:35rpx}.guide-title{color:#28513E;font-size:27rpx;font-weight:700}.guide-copy{margin-top:4rpx;color:#75857C;font-size:20rpx;line-height:1.5}.album-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18rpx;margin-top:22rpx}.album-card{position:relative;overflow:hidden;height:235rpx}.album-card image,.album-cover-empty{display:block;width:100%;height:100%}.album-cover-empty{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#47715D;background:linear-gradient(145deg,#E4EFE6,#F9EBCF)}.album-cover-empty view{font-size:56rpx}.album-cover-empty text{margin-top:5rpx;font-size:21rpx}.album-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(24,55,42,.02) 35%,rgba(24,55,42,.78))}.album-copy{position:absolute;right:39rpx;bottom:17rpx;left:16rpx;overflow:hidden;color:#fff;text-shadow:0 2rpx 7rpx rgba(0,0,0,.28)}.album-copy view{overflow:hidden;font-size:27rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.album-copy text{display:block;margin-top:3rpx;font-size:19rpx}.album-arrow{position:absolute;right:14rpx;bottom:17rpx;color:#fff;font-size:42rpx;line-height:1}.empty{margin-top:23rpx;padding:75rpx 26rpx;color:#839087;font-size:22rpx;text-align:center}
