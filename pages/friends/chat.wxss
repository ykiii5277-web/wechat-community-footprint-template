.chat-page { display:flex; flex-direction:column; height:100vh; padding-bottom:24rpx; overflow:hidden; }.chat-friend { display:flex; align-items:center; margin:4rpx 1rpx 17rpx; padding:15rpx 18rpx; border-radius:18rpx; color:#294D3A; background:rgba(255,252,246,.84); box-shadow:0 8rpx 22rpx rgba(38,70,51,.07); font-family:"Songti SC",SimSun,serif; font-size:27rpx; }.chat-friend-avatar,.message-avatar { display:flex; align-items:center; justify-content:center; overflow:hidden; border-radius:50%; color:#fff; background:#5B8068; font-family:"Songti SC",SimSun,serif; }.chat-friend-avatar image,.message-avatar image { display:block; width:100%; height:100%; transform-origin:center; }.chat-friend-avatar { width:58rpx; height:58rpx; margin-right:13rpx; font-size:25rpx; }.chat-friend text { display:block; margin-top:2rpx; color:#829087; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:18rpx; }.chat-scroll { min-height:0; flex:1; padding:0 3rpx; box-sizing:border-box; }.chat-state { margin:112rpx 10rpx; padding:38rpx 22rpx; border:2rpx dashed #D8E1D6; border-radius:19rpx; color:#78887D; background:rgba(255,252,246,.58); font-size:23rpx; line-height:1.8; text-align:center; }.message-row { display:flex; align-items:flex-start; margin:15rpx 0; }.message-row.mine { justify-content:flex-end; }.message-avatar { flex:0 0 52rpx; width:52rpx; height:52rpx; margin:20rpx 11rpx 0 0; font-size:21rpx; }.mine-avatar { margin:20rpx 0 0 11rpx; }.message-content { max-width:72%; }.message-sender-name { margin:0 5rpx 5rpx; color:#73847A; font-size:18rpx; }.message-row.mine .message-sender-name { text-align:right; }.message-bubble { padding:16rpx 18rpx; border-radius:19rpx; color:#3C5547; background:#FFFCF6; box-shadow:0 5rpx 16rpx rgba(42,68,51,.08); font-size:25rpx; line-height:1.55; white-space:pre-wrap; word-break:break-all; }.message-row.mine .message-bubble { color:#fff; background:linear-gradient(135deg,#296248,#477B5E); border-bottom-right-radius:5rpx; }.message-row.other .message-bubble { border-top-left-radius:5rpx; }.message-time { margin-top:5rpx; color:#9AA59D; font-size:17rpx; }.message-row.mine .message-time { text-align:right; }.chat-composer { display:flex; align-items:center; gap:12rpx; margin-top:15rpx; padding:13rpx; border:1rpx solid #E5E6DE; border-radius:20rpx; background:#FFFCF6; box-shadow:0 8rpx 22rpx rgba(39,70,52,.09); }.chat-composer input { flex:1; min-width:0; height:62rpx; padding:0 11rpx; color:#20362C; font-size:24rpx; }.chat-send { padding:13rpx 20rpx; border-radius:99rpx; color:#fff; background:#1F513E; font-size:23rpx; }.chat-send.disabled { color:#DDE8DF; background:#789486; }
