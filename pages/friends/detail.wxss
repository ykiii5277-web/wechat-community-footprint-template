.friend-detail { padding-left:28rpx; padding-right:28rpx; }.friend-hero { padding:28rpx 25rpx; text-align:center; }.detail-avatar { display:flex; align-items:center; justify-content:center; width:112rpx; height:112rpx; margin:0 auto 10rpx; overflow:hidden; border-radius:50%; color:#fff; background:#577B63; font-family:"Songti SC",SimSun,serif; font-size:47rpx; }.detail-avatar image { display:block; width:100%; height:100%; transform-origin:center; }.detail-name { color:#20362C; font-family:"Songti SC",SimSun,serif; font-size:37rpx; font-weight:700; }.detail-remark { display:inline-block; margin-top:8rpx; padding:5rpx 13rpx; border-radius:99rpx; color:#51705D; background:#E9F0E6; font-size:20rpx; }.detail-gender { margin-top:7rpx; color:#809087; font-size:21rpx; }.detail-bio { margin-top:17rpx; color:#52675A; font-size:25rpx; line-height:1.75; text-align:left; }.detail-tags { display:flex; justify-content:center; flex-wrap:wrap; gap:10rpx; margin-top:17rpx; }.detail-tags text { padding:7rpx 15rpx; border-radius:99rpx; color:#53735F; background:#E8F0E6; font-size:20rpx; }.friend-chat { display:flex; align-items:center; justify-content:center; gap:8rpx; margin-top:22rpx; padding:15rpx 19rpx; border-radius:17rpx; color:#fff; background:linear-gradient(115deg,#286046,#4B8062); font-size:25rpx; box-shadow:0 8rpx 18rpx rgba(31,81,62,.2); }.friend-chat text { display:inline-block; width:29rpx; height:29rpx; border:2rpx solid rgba(255,255,255,.85); border-radius:50%; font-family:Arial,sans-serif; font-size:19rpx; line-height:26rpx; }.friend-chat view { margin-left:auto; font-family:Arial,sans-serif; font-size:34rpx; line-height:1; }.content-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:17rpx; }.content-card { padding:22rpx 15rpx; color:#264B39; font-family:"Songti SC",SimSun,serif; font-size:29rpx; font-weight:700; text-align:center; }.content-card text { display:block; margin-top:5rpx; color:#829087; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:19rpx; font-weight:400; }.content-icon { display:flex; justify-content:center; align-items:center; width:65rpx; height:65rpx; margin:0 auto 10rpx; border-radius:20rpx; font-family:sans-serif; font-size:35rpx; }.content-icon.green { color:#416F51; background:#E5EEE1; }.content-icon.gold { color:#9A6A19; background:#FCF0D9; }.content-icon.blue { color:#3A6483; background:#E2EDF4; }.content-icon.red { color:#B95043; background:#F7E7E2; }.friend-tools { display:flex; gap:14rpx; margin-top:27rpx; }.friend-tool { flex:1; padding:14rpx 0; border-radius:99rpx; color:#315F49; background:#E8F0E6; font-size:24rpx; text-align:center; }.friend-tool.danger { color:#B3473A; background:#F8E8E4; }
.affection-card{margin:17rpx 0;padding:15rpx 18rpx;border-radius:17rpx;color:#77521A;background:linear-gradient(135deg,#FFF2D5,#F5F7E8);font-size:24rpx;font-weight:700;text-align:left}.affection-card text{float:right;color:#9A6A19;font-size:19rpx;font-weight:500}.affection-description{clear:both;margin-top:6rpx;color:#7B7767;font-size:19rpx;font-weight:400;line-height:1.45}
.received-panel{position:relative;margin:17rpx 0;padding:17rpx 66rpx 17rpx 19rpx}.received-title{color:#2A4B39;font-size:23rpx;font-weight:700}.received-items{display:grid;grid-template-columns:repeat(4,1fr);gap:8rpx;margin-top:12rpx}.received-item{display:grid;grid-template-columns:34rpx 1fr;align-items:center;column-gap:6rpx;color:#607469;font-size:18rpx}.received-item image{grid-row:1/3;width:34rpx;height:34rpx;border-radius:9rpx}.received-item text{color:#A66E20;font-size:20rpx;font-weight:700}
.received-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.other-gifts-button{position:absolute;top:15rpx;right:11rpx;display:flex;width:43rpx;height:112rpx;box-sizing:border-box;flex-direction:column;align-items:center;justify-content:center;padding:5rpx 4rpx;border:1rpx solid rgba(31,112,91,.28);border-radius:16rpx;color:#fff;background:#43A68F;box-shadow:0 4rpx 10rpx rgba(40,120,98,.18);font-size:18rpx}.other-gifts-label{display:flex;flex-direction:column;align-items:center;line-height:1.03;text-align:center}.other-gifts-label text{display:block}.other-gifts-arrow{margin-top:4rpx;font-size:17rpx;line-height:1}.primary-gifts{grid-template-columns:repeat(4,1fr)}.other-gift-items{grid-template-columns:repeat(3,1fr)}.other-gifts{margin-top:13rpx;padding-top:13rpx;border-top:1rpx solid rgba(49,94,74,.12)}.other-gifts-empty{padding:8rpx 0 3rpx;color:#8B958E;font-size:21rpx;text-align:center}
