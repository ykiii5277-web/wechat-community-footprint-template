.friend-editor { padding-left:28rpx; padding-right:28rpx; }.editor-card { padding:25rpx 26rpx 30rpx; }.request-intro { color:#60766A; font-size:25rpx; line-height:1.75; }.field-label { color:#1F513E; font-size:25rpx; font-weight:700; margin:16rpx 0 9rpx; }.field-hint { margin-top:-2rpx; color:#8A978D; font-size:20rpx; }.text-input { height:68rpx; box-sizing:border-box; padding:0 14rpx; color:#20362C; background:#F8F6EF; border-radius:13rpx; font-size:27rpx; }.uid-input { letter-spacing:8rpx; font-weight:700; }.body-input { display:block; width:100%; min-height:130rpx; box-sizing:border-box; padding:16rpx; background:#F8F6EF; border-radius:13rpx; color:#20362C; font-size:26rpx; line-height:1.7; }.picker-field { background:#F8F6EF; border-radius:13rpx; padding:17rpx; color:#52675A; }.picker-field text { float:right; color:#1F513E; font-size:35rpx; line-height:25rpx; }.camp-check { display:block; padding:12rpx 3rpx; color:#52675A; font-size:24rpx; }.camp-check text { margin-left:10rpx; }.request-save { margin-top:27rpx; }.editor-actions { display:flex; gap:16rpx; margin:27rpx 5rpx 0; }.save-button,.delete-button { flex:1; }.delete-button { border:0; color:#B3473A; background:#F8E8E4; border-radius:99rpx; font-size:27rpx; line-height:2.7; }.delete-button::after { border:0; }
.friend-identity { padding:20rpx; border-radius:16rpx; background:#F1F5EF; }.friend-identity-name { color:#234837; font-family:"Songti SC",SimSun,serif; font-size:34rpx; font-weight:700; }.friend-identity-bio { margin-top:8rpx; color:#627369; font-size:23rpx; line-height:1.6; }.friend-identity-tags { display:flex; flex-wrap:wrap; gap:8rpx; margin-top:12rpx; }.friend-identity-tags text { padding:5rpx 11rpx; border-radius:99rpx; color:#557260; background:#E1EBDE; font-size:19rpx; }
