<view class="friends-page">
  <view class="safe-top"></view>
  <view class="friends-heading"><view><view class="page-title">好友</view><view class="page-subtitle">与同行的人，分享彼此的成长</view></view><view class="friend-header-actions"><view class="friend-message tap" bindtap="openUnread">消息<text wx:if="{{messageCount}}">{{messageCount}}</text></view><view class="friends-count">{{friends.length}} 位</view></view></view>
  <view class="request-row card tap" bindtap="requests"><view class="request-copy"><view>好友申请</view><text>查看申请，也可直接在下方处理</text></view><view class="request-badge" wx:if="{{requestCount}}">{{requestCount}}</view><view class="friend-arrow">›</view></view>
  <view wx:if="{{pendingRequests.length}}" class="quick-request-list"><view wx:for="{{pendingRequests}}" wx:key="id" class="quick-request card"><view class="quick-request-avatar"><image wx:if="{{item.fromAvatar}}" src="{{item.fromAvatar}}" mode="aspectFill" style="transform: translate({{item.fromAvatarOffsetX}}rpx, {{item.fromAvatarOffsetY}}rpx) scale({{item.fromAvatarScale}});"></image><text wx:else>{{item.initial}}</text></view><view class="quick-request-copy"><view>{{item.fromName}}</view><text>UID {{item.fromUid}}</text></view><view class="quick-reject tap" data-id="{{item.id}}" catchtap="reject">拒绝</view><view class="quick-accept tap" data-id="{{item.id}}" catchtap="accept">同意</view></view></view>
  <view class="friend-section-heading"><view class="section-label">我的好友</view><view class="affection-guide-button tap" bindtap="showAffectionGuide">好感等级说明</view></view>
  <view wx:if="{{friends.length}}" class="friend-list"><view wx:for="{{friends}}" wx:key="id" class="friend-card card tap" data-id="{{item.id}}" bindtap="open"><view class="friend-avatar tone-{{item.tone}}"><image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" style="transform: translate({{item.avatarOffsetX}}rpx, {{item.avatarOffsetY}}rpx) scale({{item.avatarScale}});"></image><text wx:else>{{item.initial}}</text></view><view class="friend-copy"><view class="friend-name">{{item.displayName}}</view><view class="affection-line">Lv.{{item.affection.level}} · {{item.affection.title}}</view><view class="friend-bio">{{item.displayMeta}}</view></view><view wx:if="{{item.unreadCount}}" class="chat-unread">{{item.unreadCount > 99 ? '99+' : item.unreadCount}}</view><view class="friend-arrow">›</view></view></view>
  <view wx:else class="empty">还没有好友。<view>点击下方按钮，填写对方 UID 发起申请吧。</view></view>
  <view class="friend-add-bar"><view class="friend-add tap" bindtap="create">＋ 添加好友</view></view>
</view>
