.friends-page { min-height:100vh; box-sizing:border-box; padding:0 28rpx 185rpx; }.friends-heading { display:flex; justify-content:space-between; align-items:flex-start; margin:0 5rpx 21rpx; }.friend-header-actions { display:flex; align-items:center; gap:10rpx; margin-top:7rpx; }.friends-count { padding:7rpx 13rpx; border-radius:99rpx; color:#527661; background:#E7EFE4; font-size:21rpx; }.friend-message { position:relative; padding:7rpx 13rpx; border-radius:99rpx; color:#486B55; background:#FFF7E5; font-size:21rpx; }.friend-message text { position:absolute; top:-8rpx; right:-8rpx; min-width:27rpx; height:27rpx; border-radius:99rpx; color:#fff; background:#D9534F; font-size:17rpx; line-height:27rpx; text-align:center; }.request-row { display:flex; align-items:center; padding:17rpx 20rpx; color:#244836; font-size:27rpx; font-weight:700; }.request-copy { flex:1; min-width:0; }.request-row text { display:block; margin-top:3rpx; color:#829087; font-size:20rpx; font-weight:400; }.request-badge { min-width:34rpx; height:34rpx; margin-left:10rpx; margin-right:7rpx; border-radius:99rpx; color:#fff; background:#D95B50; font-size:20rpx; line-height:34rpx; text-align:center; }.friend-list { display:flex; flex-direction:column; gap:16rpx; }.friend-card { display:flex; align-items:center; padding:18rpx; }.friend-avatar { display:flex; align-items:center; justify-content:center; width:78rpx; height:78rpx; margin-right:17rpx; border-radius:50%; color:#fff; background:#587C65; font-family:"Songti SC",SimSun,serif; font-size:31rpx; }.friend-avatar.tone-1 { background:#AF8550; }.friend-avatar.tone-2 { background:#557F9A; }.friend-avatar.tone-3 { background:#B86557; }.friend-copy { flex:1; min-width:0; }.friend-name { color:#20362C; font-size:29rpx; font-weight:700; }.friend-bio { overflow:hidden; margin-top:4rpx; color:#748278; font-size:22rpx; white-space:nowrap; text-overflow:ellipsis; }.friend-arrow { color:#1F513E; font-size:44rpx; }
.friend-section-heading{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.friend-section-heading .section-label{margin-top:0}.affection-guide-button{padding:8rpx 15rpx;border:1rpx solid #DFC98E;border-radius:99rpx;color:#9A6A19;background:#FFF8E8;font-size:20rpx}
.friend-avatar { overflow:hidden; }.friend-avatar image { display:block; width:100%; height:100%; transform-origin:center; }.quick-request-list { display:flex; flex-direction:column; gap:12rpx; margin-top:12rpx; }.quick-request { display:flex; align-items:center; padding:15rpx 16rpx; }.quick-request-avatar { display:flex; align-items:center; justify-content:center; flex:0 0 58rpx; width:58rpx; height:58rpx; margin-right:12rpx; overflow:hidden; border-radius:50%; color:#fff; background:#6D8D78; font-size:23rpx; }.quick-request-avatar image { display:block; width:100%; height:100%; transform-origin:center; }.quick-request-copy { min-width:0; flex:1; color:#294B39; font-size:24rpx; font-weight:700; }.quick-request-copy text { display:block; margin-top:2rpx; color:#89958E; font-size:18rpx; font-weight:400; }.quick-reject,.quick-accept { margin-left:9rpx; padding:9rpx 13rpx; border-radius:99rpx; font-size:20rpx; }.quick-reject { color:#A45349; background:#F7E8E4; }.quick-accept { color:#fff; background:#356B50; }.chat-unread { min-width:33rpx; height:33rpx; margin:0 4rpx 0 10rpx; padding:0 5rpx; box-sizing:border-box; border-radius:99rpx; color:#fff; background:#D9584D; font-size:18rpx; line-height:33rpx; text-align:center; }
.affection-line { overflow:hidden; margin-top:3rpx; color:#B07822; font-size:20rpx; font-weight:600; white-space:nowrap; text-overflow:ellipsis; }

.friend-tabs{display:flex;margin-top:28rpx;border-bottom:1rpx solid #DCE5DA}.friend-tab{display:flex;flex:1;align-items:center;justify-content:center;gap:10rpx;padding:18rpx 0;color:#849388;font-size:30rpx}.friend-tab text{padding:1rpx 10rpx;border-radius:99rpx;background:#EAF0E5;font-size:20rpx}.friend-tab.active{position:relative;color:#24543D;font-weight:700}.friend-tab.active::after{position:absolute;right:34%;bottom:-1rpx;left:34%;height:5rpx;border-radius:4rpx;background:#527C62;content:''}
.friend-toolbar{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx;gap:14rpx}.friend-sort{padding:10rpx 18rpx;border:1rpx solid #DCE6D8;border-radius:99rpx;color:#3B654D;background:#F6F9F0;font-size:23rpx}.friend-sort text{margin-left:12rpx}.create-group{padding:10rpx 17rpx;border-radius:99rpx;color:#fff;background:#527C62;font-size:23rpx}.friend-sort-note{margin:15rpx 5rpx;color:#8A978B;font-size:20rpx;line-height:1.5}
.friend-list{gap:0;overflow:hidden}.friend-card{min-width:0;padding:23rpx 20rpx;border-bottom:1rpx solid #EDF0E8}.friend-card:last-child{border-bottom:0}.friend-avatar{flex:0 0 78rpx}.friend-name{overflow:hidden;font-size:28rpx;white-space:nowrap;text-overflow:ellipsis}.friend-group-picker{flex:0 0 auto;margin-left:12rpx}.friend-group-button{padding:11rpx 13rpx;border-radius:99rpx;color:#53745D;background:#EDF3E8;font-size:20rpx;white-space:nowrap}
.friend-group{margin-bottom:17rpx;overflow:hidden}.friend-group-heading{display:flex;align-items:center;min-height:92rpx;padding:0 21rpx;gap:12rpx}.group-chevron{flex:0 0 22rpx;color:#527C62;font-size:36rpx;line-height:1}.group-title{display:flex;flex:1;min-width:0;align-items:center;gap:12rpx;color:#294D39;font-size:27rpx;overflow:hidden}.default-group{flex:0 0 auto;padding:3rpx 8rpx;border-radius:8rpx;color:#79906D;background:#EEF2E3;font-size:18rpx}.group-count{color:#93A08F;font-size:22rpx;white-space:nowrap}.group-menu{padding:17rpx 0 17rpx 10rpx;color:#7D917C;font-size:23rpx;letter-spacing:2rpx}.group-members{border-top:1rpx solid #EDF0E8}.group-empty{padding:30rpx 22rpx;color:#96A18F;font-size:23rpx;text-align:center}
.friends-page{padding-bottom:calc(185rpx + env(safe-area-inset-bottom))}

.friend-entry-actions{display:flex;align-items:stretch;gap:16rpx}.friend-entry{display:flex;flex:1 1 0%;min-width:0;box-sizing:border-box;align-items:center;gap:10rpx;padding:22rpx 16rpx;color:#244836}.friend-entry-icon{display:flex;flex:0 0 42rpx;width:42rpx;height:42rpx;align-items:center;justify-content:center;border-radius:50%;color:#527C62;background:#EAF1E3;font-size:29rpx;line-height:1}.friend-entry-copy{flex:1;min-width:0;font-size:26rpx;font-weight:700}.friend-entry-copy text{display:block;margin-top:4rpx;color:#829087;font-size:18rpx;font-weight:400;line-height:1.5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.friend-entry-arrow{flex:0 0 auto;color:#527C62;font-size:32rpx;line-height:1}.friend-entry .request-badge{margin:0;flex:0 0 auto;min-width:30rpx;height:30rpx;font-size:18rpx;line-height:30rpx}
