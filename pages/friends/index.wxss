.friends-page { min-height:100vh; box-sizing:border-box; padding:0 28rpx 230rpx; }.friends-heading { display:flex; justify-content:space-between; align-items:flex-start; margin:0 5rpx 21rpx; }.friend-header-actions { display:flex; align-items:center; gap:10rpx; margin-top:7rpx; }.friends-count { padding:7rpx 13rpx; border-radius:99rpx; color:#527661; background:#E7EFE4; font-size:21rpx; }.friend-message { position:relative; padding:7rpx 13rpx; border-radius:99rpx; color:#486B55; background:#FFF7E5; font-size:21rpx; }.friend-message text { position:absolute; top:-8rpx; right:-8rpx; min-width:27rpx; height:27rpx; border-radius:99rpx; color:#fff; background:#D9534F; font-size:17rpx; line-height:27rpx; text-align:center; }.request-row { display:flex; align-items:center; padding:17rpx 20rpx; color:#244836; font-size:27rpx; font-weight:700; }.request-copy { flex:1; min-width:0; }.request-row text { display:block; margin-top:3rpx; color:#829087; font-size:20rpx; font-weight:400; }.request-badge { min-width:34rpx; height:34rpx; margin-left:10rpx; margin-right:7rpx; border-radius:99rpx; color:#fff; background:#D95B50; font-size:20rpx; line-height:34rpx; text-align:center; }.friend-list { display:flex; flex-direction:column; gap:16rpx; }.friend-card { display:flex; align-items:center; padding:18rpx; }.friend-avatar { display:flex; align-items:center; justify-content:center; width:78rpx; height:78rpx; margin-right:17rpx; border-radius:50%; color:#fff; background:#587C65; font-family:"Songti SC",SimSun,serif; font-size:31rpx; }.friend-avatar.tone-1 { background:#AF8550; }.friend-avatar.tone-2 { background:#557F9A; }.friend-avatar.tone-3 { background:#B86557; }.friend-copy { flex:1; min-width:0; }.friend-name { color:#20362C; font-size:29rpx; font-weight:700; }.friend-bio { overflow:hidden; margin-top:4rpx; color:#748278; font-size:22rpx; white-space:nowrap; text-overflow:ellipsis; }.friend-arrow { color:#1F513E; font-size:44rpx; }.friend-add-bar { position:fixed; z-index:99; right:0; bottom:200rpx; left:0; padding:18rpx 28rpx; background:linear-gradient(180deg,rgba(248,245,237,0),#F8F5ED 30%); }.friend-add { padding:19rpx 0; border-radius:99rpx; color:#fff; background:#1F513E; box-shadow:0 8rpx 20rpx rgba(31,81,62,.22); font-size:28rpx; text-align:center; }
.friend-section-heading{display:flex;align-items:center;justify-content:space-between;margin-top:18rpx}.friend-section-heading .section-label{margin-top:0}.affection-guide-button{padding:8rpx 15rpx;border:1rpx solid #DFC98E;border-radius:99rpx;color:#9A6A19;background:#FFF8E8;font-size:20rpx}
.friend-avatar { overflow:hidden; }.friend-avatar image { display:block; width:100%; height:100%; transform-origin:center; }.quick-request-list { display:flex; flex-direction:column; gap:12rpx; margin-top:12rpx; }.quick-request { display:flex; align-items:center; padding:15rpx 16rpx; }.quick-request-avatar { display:flex; align-items:center; justify-content:center; flex:0 0 58rpx; width:58rpx; height:58rpx; margin-right:12rpx; overflow:hidden; border-radius:50%; color:#fff; background:#6D8D78; font-size:23rpx; }.quick-request-avatar image { display:block; width:100%; height:100%; transform-origin:center; }.quick-request-copy { min-width:0; flex:1; color:#294B39; font-size:24rpx; font-weight:700; }.quick-request-copy text { display:block; margin-top:2rpx; color:#89958E; font-size:18rpx; font-weight:400; }.quick-reject,.quick-accept { margin-left:9rpx; padding:9rpx 13rpx; border-radius:99rpx; font-size:20rpx; }.quick-reject { color:#A45349; background:#F7E8E4; }.quick-accept { color:#fff; background:#356B50; }.chat-unread { min-width:33rpx; height:33rpx; margin:0 4rpx 0 10rpx; padding:0 5rpx; box-sizing:border-box; border-radius:99rpx; color:#fff; background:#D9584D; font-size:18rpx; line-height:33rpx; text-align:center; }
.affection-line { overflow:hidden; margin-top:3rpx; color:#B07822; font-size:20rpx; font-weight:600; white-space:nowrap; text-overflow:ellipsis; }
