<view class="page-shell request-page"><page-nav title="好友申请"></page-nav><view wx:if="{{requests.length}}" class="request-list"><view wx:for="{{requests}}" wx:key="id" class="request-card card"><view class="request-top"><view class="request-avatar"><image wx:if="{{item.fromAvatar}}" src="{{item.fromAvatar}}" mode="aspectFill" style="transform: translate({{item.fromAvatarOffsetX}}rpx, {{item.fromAvatarOffsetY}}rpx) scale({{item.fromAvatarScale}});"></image><text wx:else>{{item.initial}}</text></view><view class="request-copy"><view class="request-name">{{item.fromName}}</view><view class="request-uid">UID {{item.fromUid}}</view></view></view><view wx:if="{{item.reason}}" class="request-reason">“{{item.reason}}”</view><view wx:else class="request-reason muted">对方没有填写申请理由</view><view class="request-actions"><view class="request-reject tap" data-id="{{item.id}}" bindtap="reject">拒绝</view><view class="request-accept tap" data-id="{{item.id}}" bindtap="accept">同意</view></view></view></view><view wx:else class="empty">暂无待处理的好友申请。</view></view>
