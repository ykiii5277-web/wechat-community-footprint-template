.request-page { padding-left:28rpx; padding-right:28rpx; }.request-list { display:flex; flex-direction:column; gap:18rpx; }.request-card { padding:22rpx; }.request-top { display:flex; align-items:center; }.request-avatar { display:flex; box-sizing:border-box; align-items:center; justify-content:center; width:73rpx; height:73rpx; margin-right:15rpx; overflow:hidden; border-radius:50%; color:#fff; background:#587C65; font-family:"Songti SC",SimSun,serif; font-size:30rpx; }.request-avatar image { display:block; width:100%; height:100%; transform-origin:center; }.request-copy { flex:1; }.request-name { color:#20362C; font-size:29rpx; font-weight:700; }.request-uid { margin-top:3rpx; color:#86938A; font-size:20rpx; }.request-reason { margin-top:18rpx; padding:14rpx 16rpx; border-radius:12rpx; color:#52675A; background:#F5F3EB; font-size:24rpx; line-height:1.65; }.request-actions { display:flex; justify-content:flex-end; gap:14rpx; margin-top:18rpx; }.request-reject,.request-accept { min-width:122rpx; padding:11rpx 0; border-radius:99rpx; font-size:24rpx; text-align:center; }.request-reject { color:#936057; background:#F8E9E5; }.request-accept { color:#fff; background:#1F513E; }
