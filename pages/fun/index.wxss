/* 以完整纵向水彩纸作为固定背景层，文字与卡片仅叠加在它预留的干净区域内。 */
.fun-page { position:relative; min-height:1370rpx; overflow:hidden; box-sizing:border-box; padding:0 28rpx 185rpx; background:#FCF8EF; }.fun-page-background { position:absolute; z-index:0; top:0; left:0; display:block; width:100%; height:1600rpx; pointer-events:none; }.fun-page > .safe-top,.fun-heading,.heat-rule,.range-tabs,.rank-filters,.ranking-heading,.ranking-list,.fun-empty,.rank-footnote { position:relative; z-index:1; }
.fun-heading { margin:25rpx 6rpx 29rpx; }.fun-heading .page-title { color:#1E4C38; font-family:"STKaiti","KaiTi","Songti SC",SimSun,serif; font-size:57rpx; font-weight:700; letter-spacing:3rpx; line-height:1.15; }.fun-heading .page-subtitle { margin-top:14rpx; color:#56685F; font-family:"STKaiti","KaiTi","Songti SC",SimSun,serif; font-size:29rpx; letter-spacing:1rpx; }
.heat-rule { display:flex; align-items:center; min-height:113rpx; padding:0 23rpx; border-radius:25rpx; background:rgba(255,253,247,.93); box-shadow:0 12rpx 25rpx rgba(49,68,50,.1); }.search-box { gap:13rpx; min-height:100rpx; padding:0 18rpx 0 25rpx; }.search-icon { flex:0 0 auto; color:#547A66; font-family:Arial,sans-serif; font-size:48rpx; line-height:1; transform:rotate(-18deg); }.search-input { min-width:0; flex:1; height:75rpx; color:#244C39; font-family:"Songti SC",SimSun,serif; font-size:27rpx; }.search-placeholder { color:#95A397; }.search-clear { display:flex; align-items:center; justify-content:center; flex:0 0 36rpx; width:36rpx; height:36rpx; border-radius:50%; color:#7B8B80; background:#EDF1E9; font-size:29rpx; line-height:1; }.search-submit { flex:0 0 auto; padding:12rpx 18rpx; border-radius:99rpx; color:#fff; background:#3D7359; font-size:22rpx; line-height:1.1; }
.range-tabs { display:flex; gap:17rpx; margin:29rpx 0 44rpx; }.range-tab { display:flex; align-items:center; justify-content:center; flex:1; min-width:0; height:57rpx; border-radius:99rpx; color:#335843; background:linear-gradient(90deg,#F0F0E8,#F4F2EB); font-family:"Songti SC",SimSun,serif; font-size:28rpx; }.range-tab.active { color:#fff; background:linear-gradient(110deg,#205E45,#337558); box-shadow:0 7rpx 14rpx rgba(32,88,65,.19); }
.rank-filters { display:flex; gap:16rpx; margin:-24rpx 0 31rpx; padding:12rpx 15rpx; border-radius:17rpx; }.rank-filters picker { flex:1; }.filter-picker { padding:10rpx 13rpx; border-radius:12rpx; color:#3D6350; background:#F1F4EC; font-size:22rpx; }.filter-picker text { float:right; color:#789083; }
.ranking-heading { display:flex; align-items:flex-end; justify-content:space-between; margin:0 5rpx; }.ranking-title { color:#214D39; font-family:"Songti SC",SimSun,serif; font-size:43rpx; font-weight:700; letter-spacing:2rpx; line-height:1.15; }.ranking-note { margin-top:7rpx; color:#687A70; font-family:"Songti SC",SimSun,serif; font-size:24rpx; }.ranking-count { margin-bottom:4rpx; padding:8rpx 17rpx; border-radius:99rpx; color:#B66A20; background:#FFF0D3; font-family:"Songti SC",SimSun,serif; font-size:24rpx; }
.ranking-heading-actions{display:flex;flex:0 0 auto;flex-direction:column;align-items:flex-end;gap:8rpx;margin-left:12rpx}.ranking-reward-guide{padding:7rpx 14rpx;border:1rpx solid #D8C078;border-radius:99rpx;color:#8E641A;background:rgba(255,249,230,.9);font-size:20rpx}.ranking-heading-actions .ranking-count{margin-bottom:4rpx}
.ranking-list { display:flex; flex-direction:column; gap:15rpx; margin-top:31rpx; }.ranking-card { display:flex; align-items:center; min-height:144rpx; padding:16rpx; box-sizing:border-box; border-radius:22rpx; }.rank-number { display:flex; align-items:center; justify-content:center; flex:0 0 40rpx; width:40rpx; height:40rpx; margin-right:12rpx; border-radius:50%; color:#698174; background:#EAF0E8; font-family:"Songti SC",SimSun,serif; font-size:22rpx; font-weight:700; }.rank-1 { color:#A76B16; background:#FBE8BC; }.rank-2 { color:#66747A; background:#E8EEF0; }.rank-3 { color:#98654A; background:#F4E1D3; }.rank-art { display:flex; align-items:center; justify-content:center; flex:0 0 104rpx; width:104rpx; height:104rpx; overflow:hidden; border-radius:16rpx; color:#fff; background:#668C77; font-size:41rpx; }.rank-art image { display:block; width:100%; height:100%; }.art-photo { background:#AC845A; }.art-growth { background:#5B8A79; }.art-work { background:#628CA0; }.rank-copy { min-width:0; flex:1; margin-left:16rpx; }.rank-title-row { display:flex; align-items:center; gap:8rpx; }.rank-title { min-width:0; flex:1; overflow:hidden; color:#20362C; font-family:"Songti SC",SimSun,serif; font-size:27rpx; font-weight:700; white-space:nowrap; text-overflow:ellipsis; }.kind-pill { flex:0 0 auto; padding:3rpx 8rpx; border-radius:99rpx; font-size:17rpx; }.kind-photo { color:#91622A; background:#F9EDD8; }.kind-growth { color:#416B58; background:#E4F0E9; }.kind-work { color:#436F85; background:#E4EFF2; }.rank-summary { overflow:hidden; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:1; margin-top:5rpx; color:#748278; font-size:20rpx; line-height:1.45; }.rank-meta { margin-top:8rpx; color:#819087; font-size:19rpx; }.heat-score { flex:0 0 59rpx; margin-left:7rpx; color:#BB6D3D; text-align:right; font-family:"Songti SC",SimSun,serif; font-size:27rpx; font-weight:700; }.heat-score text { display:block; color:#9A9A81; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; font-size:17rpx; font-weight:400; }
.fun-empty { min-height:174rpx; margin:43rpx 10rpx 0; padding:24rpx 18rpx 20rpx; box-sizing:border-box; border:2rpx dashed #C8D2C4; border-radius:22rpx; color:#315641; background:rgba(255,253,247,.44); font-family:"Songti SC",SimSun,serif; font-size:24rpx; line-height:1.7; text-align:center; }.rank-footnote { margin:36rpx 7rpx 0; color:#728177; font-family:"Songti SC",SimSun,serif; font-size:24rpx; line-height:1.7; text-align:center; }
.profile-guide-mask { position:fixed; z-index:200; top:0; right:0; bottom:0; left:0; display:flex; align-items:center; justify-content:center; padding:48rpx; box-sizing:border-box; background:rgba(20,47,37,.48); }.profile-guide-card { width:100%; max-width:580rpx; padding:43rpx 38rpx 33rpx; box-sizing:border-box; border:1rpx solid rgba(255,255,255,.8); border-radius:31rpx; background:#FFFCF6; box-shadow:0 18rpx 55rpx rgba(13,42,31,.3); text-align:center; }.profile-guide-leaf { display:flex; align-items:center; justify-content:center; width:70rpx; height:70rpx; margin:0 auto 15rpx; border-radius:50%; color:#fff; background:#527D60; font-size:33rpx; }.profile-guide-title { color:#355E46; font-family:"Songti SC",SimSun,serif; font-size:35rpx; }.profile-guide-title text { margin-left:7rpx; color:#1F513E; font-size:40rpx; font-weight:800; }.profile-guide-copy { margin-top:25rpx; color:#435D4E; font-size:25rpx; line-height:1.75; text-align:left; }.profile-guide-note { margin-top:9rpx; color:#849188; font-size:20rpx; line-height:1.65; text-align:left; }.profile-guide-actions { display:flex; gap:16rpx; margin-top:31rpx; }.guide-skip,.guide-confirm { flex:1; padding:16rpx 0; border-radius:99rpx; font-size:26rpx; }.guide-skip { color:#567061; background:#E8EEE5; }.guide-confirm { color:#fff; background:#1F513E; box-shadow:0 7rpx 16rpx rgba(31,81,62,.22); }
.kind-tabs,.page-actions { position:relative; z-index:1; }.kind-tabs { display:flex; gap:10rpx; margin:-20rpx 0 30rpx; padding:8rpx; border-radius:17rpx; background:rgba(255,253,247,.63); }.kind-tab { flex:1; min-width:0; padding:10rpx 0; border-radius:99rpx; color:#587060; background:#EEF1EA; font-size:21rpx; text-align:center; }.kind-tab.active { color:#fff; background:#527C62; box-shadow:0 4rpx 10rpx rgba(31,81,62,.15); }.page-actions { display:flex; align-items:center; justify-content:center; gap:16rpx; margin:29rpx auto 0; }.page-button { min-width:144rpx; padding:14rpx 17rpx; box-sizing:border-box; border-radius:99rpx; color:#315F49; background:rgba(255,253,247,.93); box-shadow:0 7rpx 17rpx rgba(50,72,53,.1); font-size:22rpx; text-align:center; }.page-button.disabled { color:#B3BDB5; background:rgba(245,246,240,.74); box-shadow:none; }.page-number { min-width:92rpx; color:#708177; font-size:21rpx; text-align:center; }
