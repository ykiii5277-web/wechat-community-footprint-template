<view wx:if="{{entry}}" class="page-shell growth-detail"><page-nav title="记录详情"></page-nav><view class="detail-card card"><view wx:if="{{entry.images.length}}" class="detail-image-grid image-count-{{entry.images.length}}"><image wx:for="{{entry.images}}" wx:key="*this" class="tap" src="{{item}}" mode="aspectFill" data-index="{{index}}" bindtap="previewImage"></image></view><view wx:if="{{entry.images.length}}" class="image-preview-tip">点击查看大图 · 双指缩放 · 长按保存</view><scene-banner wx:else scene="{{camp.scene}}" compact="{{true}}"></scene-banner><view class="detail-copy"><view class="detail-title">{{entry.title}}</view><view class="detail-meta">{{entry.date}}　·　{{camp.name}}　·　👁 {{entry.views}} 浏览　·　♥ {{entry.likes}} 点赞</view><view wx:if="{{entry.location}}" class="detail-location">⌖ {{entry.location}}</view><view class="content-visibility">可见范围 · {{entry.visibilityLabel}}</view><view class="detail-body">{{entry.body}}</view></view></view><view class="detail-actions"><view class="detail-action like tap" bindtap="favorite">{{entry.favorite ? '♥ 已点赞' : '♡ 点赞'}} {{entry.likes}}</view><view class="detail-action tap" bindtap="edit">编辑</view><view class="detail-action danger tap" bindtap="remove">删除</view></view><comment-panel target-type="growth" target-id="{{entry.id}}" bind:change="refresh"></comment-panel></view>
