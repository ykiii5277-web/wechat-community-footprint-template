.growth-detail { padding-left:28rpx; padding-right:28rpx; }.detail-card { overflow:hidden; }.detail-card scene-banner { display:block; }.detail-image-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:4rpx; background:#EEF1EA; }.detail-image-grid image { display:block; width:100%; height:190rpx; }.detail-image-grid.image-count-1 { grid-template-columns:1fr; }.detail-image-grid.image-count-1 image { height:320rpx; }.detail-image-grid.image-count-2 { grid-template-columns:repeat(2,1fr); }.detail-image-grid.image-count-2 image { height:260rpx; }.detail-copy { padding:25rpx 26rpx 30rpx; }.detail-title { color:#20362C; font-family:"Songti SC",SimSun,serif; font-size:40rpx; font-weight:700; }.detail-meta { color:#718078; font-size:22rpx; margin-top:8rpx; }.detail-location { margin-top:12rpx; color:#667B70; font-size:22rpx; }.detail-tags { margin-top:13rpx; }.content-visibility { display:inline-block; margin-top:12rpx; padding:3rpx 9rpx; border-radius:99rpx; color:#557260; background:#EDF2E8; font-size:18rpx; }.detail-body { white-space:pre-wrap; color:#42594C; font-size:27rpx; line-height:2; margin-top:24rpx; }.detail-actions { display:flex; gap:15rpx; margin-top:24rpx; }.detail-action { flex:1; padding:14rpx 0; text-align:center; border-radius:99rpx; color:#315F49; background:#EDF1E9; font-size:25rpx; }.detail-action.like { color:#B95043; background:#F8E8E4; }.detail-action.danger { color:#B3473A; background:#F8E8E4; }
