.editor-page { padding-left:28rpx; padding-right:28rpx; }
.editor-card { padding:25rpx 26rpx 30rpx; }
.field-label { margin:16rpx 0 9rpx; color:#1F513E; font-size:25rpx; font-weight:700; }
.title-input { height:66rpx; color:#20362C; border-bottom:2rpx solid #E6E3D9; font-size:31rpx; }
.text-input { box-sizing:border-box; width:100%; height:68rpx; padding:0 17rpx; border-radius:13rpx; color:#20362C; background:#F8F6EF; font-size:26rpx; }
.body-input { display:block; width:100%; min-height:160rpx; padding:16rpx; box-sizing:border-box; border-radius:13rpx; background:#F8F6EF; font-size:26rpx; line-height:1.7; }
.picker-field { padding:17rpx; border-radius:13rpx; color:#52675A; background:#F8F6EF; }
.picker-field text { float:right; color:#1F513E; font-size:35rpx; line-height:25rpx; }
.visibility-hint { margin:7rpx 5rpx 1rpx; color:#859187; font-size:20rpx; }
.image-picker { padding:28rpx; border:2rpx dashed #C9D7C9; border-radius:16rpx; color:#607A68; background:#F3F4EC; font-size:24rpx; text-align:center; }
.image-plus { color:#1F513E; font-size:42rpx; }
.image-picker .muted { margin-top:3rpx; font-size:20rpx; }
.record-image-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; }
.record-image-thumb,.record-image-add { position:relative; height:190rpx; overflow:hidden; border-radius:15rpx; }
.record-image-thumb image { display:block; width:100%; height:100%; }
.record-image-add { display:flex; flex-direction:column; align-items:center; justify-content:center; border:2rpx dashed #C9D7C9; color:#607A68; background:#F3F4EC; font-size:21rpx; }
.record-image-add view { color:#1F513E; font-size:38rpx; line-height:1; }
.remove-image { position:absolute; top:8rpx; right:8rpx; width:42rpx; height:42rpx; border-radius:50%; color:#fff; background:rgba(32,54,44,.72); font-size:34rpx; line-height:38rpx; text-align:center; }
.save-btn { margin:27rpx 5rpx 20rpx; }
