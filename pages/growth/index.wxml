<view class="growth-page page-shell">
  <page-nav title="{{mode === 'records' ? '记录' : '作品'}}" subtitle="{{title}}"></page-nav>
  <block wx:if="{{mode === 'records'}}">
    <view class="section-label">这里的记录</view>
    <view wx:if="{{records.length}}" class="growth-list"><view wx:for="{{records}}" wx:key="id" class="growth-card card tap" data-id="{{item.id}}" bindtap="detailRecord"><view class="entry-art"><image lazy-load="{{true}}" wx:if="{{item.image && !item.imageFailed}}" class="entry-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" binderror="imageError"></image><scene-banner wx:else scene="{{item.scene}}" compact="{{true}}"></scene-banner></view><view class="entry-copy"><view class="entry-heading"><view class="entry-title">{{item.title}}</view><text class="entry-heart">♥ {{item.likes}}</text></view><view class="entry-body">{{item.body}}</view><view class="entry-meta">▧ {{item.date}}　·　{{item.campName}}　👁 {{item.views}}</view><view wx:if="{{item.location}}" class="entry-location">⌖ {{item.location}}</view></view></view></view>
    <view wx:else class="empty">这里还没有记录。<view>点击底部“写记录”留下第一段感受吧。</view></view>
  </block>
  <block wx:else>
    <view class="section-label">这里的作品</view>
    <view wx:if="{{works.length}}" class="works-list"><view wx:for="{{works}}" wx:key="id" class="work-card card tap" data-id="{{item.id}}" bindtap="detailWork"><view class="work-art"><view wx:if="{{item.filePath}}" class="work-file-art">▤</view><image lazy-load="{{true}}" wx:elif="{{item.cover}}" src="{{item.cover}}" mode="aspectFill"></image><scene-banner wx:else scene="{{item.scene}}" compact="{{true}}"></scene-banner></view><view class="work-copy"><view class="work-title">{{item.title}}</view><view class="work-date">{{item.date}} <text wx:if="{{item.status === 'draft'}}" class="draft-badge">草稿</text><text wx:elif="{{item.reviewStatus === 'rejected' || item.visibility === 'public' && item.reviewStatus === 'pending'}}" class="draft-badge">{{item.reviewStatus === 'rejected' ? '附件未通过' : '附件待审核'}}</text></view><view wx:if="{{item.fileName}}" class="work-file-name">▤ {{item.fileName}}</view><view wx:if="{{item.location}}" class="work-location">⌖ {{item.location}}</view><view class="work-heart">👁 {{item.views}}　♥ {{item.likes}}</view></view><view class="work-arrow">›</view></view></view>
    <view wx:else class="empty">这里还没有作品。<view>点击底部“新建作品”上传第一份文件吧。</view></view>
  </block>
  <view class="growth-create-bar"><view class="growth-create tap" bindtap="create">{{mode === 'records' ? '＋ 写记录' : '＋ 新建作品'}}</view></view>
</view>
