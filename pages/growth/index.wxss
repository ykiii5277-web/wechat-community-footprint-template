.growth-page { position:relative; padding-left:28rpx; padding-right:28rpx; padding-bottom:220rpx; }.growth-list,.works-list { display:flex; flex-direction:column; gap:19rpx; }.growth-card { overflow:hidden; }.entry-art { height:208rpx; overflow:hidden; }.entry-art scene-banner { display:block; height:100%; }.entry-image { display:block; width:100%; height:100%; }.entry-copy { padding:20rpx 22rpx 18rpx; }.entry-heading { display:flex; align-items:center; }.entry-title { flex:1; color:#20362C; font-family:"Songti SC",SimSun,serif; font-size:31rpx; font-weight:700; }.entry-heart { color:#CF6A60; font-size:30rpx; }.entry-body { overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; color:#52675A; font-size:24rpx; line-height:1.75; margin-top:6rpx; }.entry-meta,.entry-location { overflow:hidden; color:#718078; font-size:20rpx; margin-top:9rpx; white-space:nowrap; text-overflow:ellipsis; }.entry-meta { margin-top:13rpx; }.entry-tags { margin-top:10rpx; }.small-tag { display:inline-block; color:#537060; background:#EDF1E9; border-radius:99rpx; padding:3rpx 12rpx; font-size:19rpx; margin-right:8rpx; }.work-card { position:relative; display:flex; overflow:hidden; min-height:191rpx; }.work-art { flex:0 0 220rpx; width:220rpx; overflow:hidden; }.work-art image { display:block; width:100%; height:100%; }.work-art scene-banner { display:block; height:100%; }.work-file-art { display:flex; align-items:center; justify-content:center; width:100%; height:100%; color:#4D7594; background:linear-gradient(145deg,#E8F0F2,#DCE8EB); font-size:70rpx; }.work-copy { padding:23rpx 42rpx 18rpx 22rpx; }.work-title { color:#20362C; font-family:"Songti SC",SimSun,serif; font-size:30rpx; font-weight:700; }.work-date { color:#718078; font-size:21rpx; margin-top:13rpx; }.draft-badge { display:inline-block; margin-left:9rpx; padding:2rpx 9rpx; border-radius:99rpx; color:#8A6C31; background:#FFF0D2; font-size:18rpx; }.work-file-name,.work-location,.work-heart { color:#718078; font-size:20rpx; margin-top:5rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.work-file-name { color:#4D7594; }.work-heart { color:#CF6A60; }.work-arrow { position:absolute; right:15rpx; top:50%; margin-top:-25rpx; color:#1F513E; font-size:47rpx; }.growth-create-bar { position:fixed; z-index:10; right:0; bottom:104rpx; left:0; padding:18rpx 28rpx; background:linear-gradient(180deg,rgba(248,245,237,0),#F8F5ED 30%); }.growth-create { padding:19rpx 0; border-radius:99rpx; color:#fff; background:#1F513E; box-shadow:0 8rpx 20rpx rgba(31,81,62,.22); font-size:28rpx; text-align:center; }
