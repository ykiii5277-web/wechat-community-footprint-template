page { background:#000; overflow:hidden; }
.image-viewer,.gallery { position:fixed; inset:0; width:100%; height:100%; background:#000; }
.image-area,.full-image { width:100%; height:100%; }
.image-area { position:relative; overflow:hidden; }
.full-image { display:block; }
.viewer-toolbar { position:fixed; top:0; left:0; right:0; z-index:5; height:88rpx; box-sizing:content-box; display:flex; align-items:center; background:linear-gradient(rgba(0,0,0,.65),transparent); color:#fff; }
.viewer-close { padding:16rpx 28rpx; font-size:30rpx; }
.viewer-counter { position:absolute; left:40%; width:20%; text-align:center; font-size:28rpx; pointer-events:none; }
.viewer-footer { position:fixed; bottom:0; left:0; right:0; z-index:5; padding:28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); background:linear-gradient(transparent,rgba(0,0,0,.8)); text-align:center; }
.viewer-hint { color:rgba(255,255,255,.75); font-size:23rpx; margin-bottom:18rpx; }
.save-image { display:inline-block; min-width:200rpx; padding:0 30rpx; border:1rpx solid rgba(255,255,255,.5); border-radius:40rpx; background:rgba(255,255,255,.12); color:#fff; font-size:26rpx; line-height:70rpx; }
.save-image::after { border:0; }
.image-error { position:absolute; left:0; right:0; top:48%; color:#ddd; text-align:center; font-size:26rpx; pointer-events:none; }
