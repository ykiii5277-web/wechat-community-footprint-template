.page { min-height:100vh; padding-bottom:175rpx; box-sizing:border-box; background:#F8F5ED; }.safe { height:env(safe-area-inset-top); min-height:24rpx; }.header { display:flex; align-items:center; height:92rpx; padding:0 26rpx; }.back,.header-space { flex:0 0 78rpx; width:78rpx; }.back { color:#1F513E; font-family:sans-serif; font-size:68rpx; line-height:65rpx; }.title { flex:1; color:#1F513E; font-family:"Songti SC",SimSun,serif; font-size:37rpx; font-weight:700; letter-spacing:1rpx; text-align:center; }.intro { padding:3rpx 40rpx 24rpx; }.intro-title { color:#244D3A; font-family:"Songti SC",SimSun,serif; font-size:31rpx; font-weight:700; }.intro-copy { margin-top:7rpx; color:#788B80; font-size:22rpx; }.map { position:relative; height:1185rpx; margin:0 26rpx; overflow:hidden; border-radius:31rpx; background:#DDE9EC; box-shadow:0 16rpx 38rpx rgba(35,68,54,.14); }.map-image { display:block; width:100%; height:100%; }.spot { position:absolute; z-index:2; display:flex; align-items:center; }.winter { top:166rpx; left:36rpx; }.spark { top:486rpx; right:22rpx; }.other { top:856rpx; left:35rpx; }.pin { display:flex; align-items:center; justify-content:center; width:76rpx; height:76rpx; box-sizing:border-box; border:7rpx solid rgba(255,255,255,.94); border-radius:50% 50% 50% 5rpx; transform:rotate(-45deg); color:#fff; box-shadow:0 7rpx 16rpx rgba(23,62,47,.25); font-size:34rpx; }.pin text { display:block; transform:rotate(45deg); }.pin-winter { background:#2E6870; }.pin-spark { background:#D2942E; }.pin-other { background:#3E7958; }.label { min-width:173rpx; margin-left:18rpx; padding:15rpx 20rpx; border-radius:99rpx; color:#203C2E; background:rgba(255,253,248,.96); box-shadow:0 6rpx 16rpx rgba(37,65,53,.14); font-family:"Songti SC",SimSun,serif; font-size:31rpx; font-weight:700; }.label text { float:right; margin-left:20rpx; color:#4C725C; font-family:sans-serif; font-size:39rpx; line-height:27rpx; }.note { margin:23rpx 42rpx 0; color:#6D8174; font-size:21rpx; line-height:1.7; text-align:center; }.tabbar { position:fixed; z-index:20; right:0; bottom:0; left:0; display:flex; height:121rpx; padding:14rpx 14rpx calc(12rpx + env(safe-area-inset-bottom)); box-sizing:content-box; border-top:1rpx solid rgba(216,210,197,.82); background:#FFFDF8; }.tab { flex:1; color:#767977; font-family:"Songti SC",SimSun,serif; font-size:27rpx; line-height:1.1; text-align:center; }.tab image { display:block; width:67rpx; height:67rpx; margin:0 auto 5rpx; }.tab:first-child image { filter:grayscale(.7) opacity(.58); }.tab.active { color:#254E3B; font-weight:700; }.tab.active image { filter:brightness(.72) sepia(.4) saturate(1.7) hue-rotate(94deg); }
.path-notice { position:absolute; z-index:3; top:-12rpx; left:42rpx; display:flex; align-items:center; justify-content:center; width:31rpx; height:31rpx; border:3rpx solid #fff; border-radius:50%; color:#fff; background:#D9534F; box-shadow:0 3rpx 8rpx rgba(122,45,41,.28); font-size:22rpx; font-weight:700; }
