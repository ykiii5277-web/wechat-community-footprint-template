<view wx:if="{{photo}}" class="page-shell preview-page"><page-nav title="图片详情"></page-nav><view class="large-photo card"><image wx:if="{{photo.image}}" class="tap" src="{{photo.image}}" mode="aspectFit" bindtap="previewImage"></image><scene-banner wx:else scene="{{camp.scene}}"></scene-banner><view wx:if="{{photo.image}}" class="image-preview-tip">点击查看大图 · 双指缩放 · 长按保存</view></view><view class="photo-info card"><view><view wx:if="{{photo.showName || photo.visibility === 'public'}}" class="photo-name">{{photo.name}}</view><view class="muted">{{camp.name}} · {{photo.date}}</view><view class="photo-metrics">👁 {{photo.views}} 浏览　♥ {{photo.likes}} 点赞</view><view class="content-visibility">可见范围 · {{photo.visibilityLabel}}</view></view><view class="favorite tap" bindtap="favorite"><text class="star">{{photo.favorite ? '♥' : '♡'}}</text><text>{{photo.favorite ? '已点赞' : '点赞'}}</text></view></view><comment-panel target-type="photo" target-id="{{photo.id}}" bind:change="refresh"></comment-panel><view class="preview-actions"><view class="preview-action tap" bindtap="edit">编辑</view><view class="preview-action danger tap" bindtap="remove">删除</view></view></view>
