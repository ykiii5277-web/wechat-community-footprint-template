.backpack-page{padding:0 28rpx 80rpx}.benefit-note{margin-bottom:20rpx;padding:20rpx 22rpx;color:#315B45;background:linear-gradient(135deg,#F7F0D8,#F7FAF1)}.benefit-note view{font-size:27rpx;font-weight:700}.benefit-note text{display:block;margin-top:5rpx;color:#738078;font-size:21rpx}.item-list{display:flex;flex-direction:column;gap:16rpx}.item-card{display:flex;align-items:center;padding:18rpx}.item-image{width:96rpx;height:96rpx;flex:0 0 96rpx;border-radius:23rpx}.item-copy{flex:1;min-width:0;margin-left:18rpx}.item-heading{display:flex;justify-content:space-between;color:#20362C;font-size:29rpx;font-weight:700}.item-heading view{color:#9A6A19}.item-intro{margin-top:5rpx;color:#718078;font-size:21rpx;line-height:1.45}.received{margin-top:7rpx;color:#799081;font-size:19rpx}.gift-button{margin-left:14rpx;padding:12rpx 20rpx;border-radius:99rpx;color:#fff;background:#2F674E;font-size:22rpx}.gift-button.disabled{color:#9CA59F;background:#E8E8E2}
.backpack-page>.empty{padding:72rpx 20rpx;color:#87938B;font-size:24rpx;text-align:center}
