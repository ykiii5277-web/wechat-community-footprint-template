.favorites-page { padding-left:28rpx; padding-right:28rpx; }
.favorite-tabs { display:flex; gap:14rpx; margin:4rpx 0 22rpx; }
.favorite-tab { flex:1; padding:11rpx 0; text-align:center; border-radius:99rpx; color:#52675A; font-size:25rpx; background:#F1EEE5; }
.favorite-tab.active { color:#fff; background:#2F674E; }
.favorite-list { display:flex; flex-direction:column; gap:18rpx; }
.favorite-card { position:relative; overflow:hidden; display:flex; min-height:155rpx; }
.favorite-art { width:185rpx; flex:0 0 185rpx; overflow:hidden; }
.favorite-art image { display:block; width:100%; height:100%; min-height:155rpx; }
.favorite-art scene-banner { display:block; height:100%; }
.comment-art { display:flex; align-items:center; justify-content:center; height:100%; color:#527661; background:#EAF0E6; font-size:57rpx; }
.favorite-copy { flex:1; min-width:0; padding:21rpx 58rpx 21rpx 15rpx; overflow:hidden; }
.favorite-title { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#20362C; font-family:"Songti SC",SimSun,serif; font-weight:700; font-size:28rpx; }
.favorite-body { overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; margin-top:6rpx; color:#607268; font-size:22rpx; line-height:1.5; }
.favorite-meta { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#87958B; font-size:19rpx; margin-top:11rpx; }
.unfav { position:absolute; right:14rpx; top:8rpx; padding:8rpx; font-size:33rpx; color:#CF6A60; }
