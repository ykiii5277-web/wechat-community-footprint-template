.gift-page{padding:0 28rpx 70rpx}.gift-hero{display:flex;align-items:center;padding:20rpx}.gift-hero image{width:108rpx;height:108rpx;border-radius:25rpx;margin-right:20rpx}.gift-hero view view{color:#20362C;font-size:31rpx;font-weight:700}.gift-hero text{display:block;margin-top:7rpx;color:#77867C;font-size:22rpx}.mode-tabs{display:flex;gap:12rpx;margin:18rpx 0}.mode-tabs view{flex:1;padding:13rpx;text-align:center;border-radius:99rpx;color:#57705F;background:#ECEDE5}.mode-tabs .active{color:#fff;background:#2F674E}.gift-form{padding:22rpx}.recipient-block{width:100%;overflow:visible}.field-label{margin:18rpx 0 9rpx;color:#2A4A39;font-size:23rpx;font-weight:700}.field-label:first-child{margin-top:0}.field-input,.message-input{box-sizing:border-box;width:100%;border-radius:16rpx;color:#273B31;background:#F3F3EC;font-size:24rpx}.field-input{display:block;height:76rpx;min-height:76rpx;padding:0 18rpx;line-height:76rpx}.picker{display:flex;align-items:center;justify-content:space-between}.message-input{min-height:190rpx;padding:17rpx 18rpx;line-height:1.6}.quantity{display:flex;align-items:center;width:240rpx;border-radius:99rpx;background:#F1F1EA}.quantity view{width:70rpx;padding:12rpx 0;text-align:center;color:#2F674E;font-size:31rpx}.quantity text{flex:1;text-align:center;font-weight:700}.empty-friends{padding:18rpx;border-radius:16rpx;color:#7A877F;background:#F4F3ED;font-size:22rpx}.image-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12rpx}.image-cell,.image-add{position:relative;aspect-ratio:1;border-radius:15rpx;overflow:hidden}.image-cell image{width:100%;height:100%}.image-remove{position:absolute;top:6rpx;right:6rpx;width:35rpx;height:35rpx;border-radius:50%;color:#fff;background:rgba(0,0,0,.55);line-height:33rpx;text-align:center}.image-add{display:flex;flex-direction:column;align-items:center;justify-content:center;color:#63806C;background:#EDF1E8;font-size:38rpx}.image-add text{font-size:18rpx}.gift-tip{margin:18rpx 8rpx;color:#829087;font-size:20rpx;line-height:1.5}.send-button{margin-top:18rpx}
