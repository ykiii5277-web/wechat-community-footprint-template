<view wx:if="{{profile}}" class="profile-page page-shell">
  <view class="safe-top"></view>
  <view class="profile-hero">
    <!-- 使用足迹页同一张水彩地图，避免依赖部分设备不稳定的 CSS 背景图渲染。 -->
    <image class="profile-hero-scene" src="/assets/images/footprints-map-v2.jpg" mode="widthFix"></image>
    <view class="profile-hero-veil"></view>
    <!-- 除背景图外的头像与菜单前景统一下移，保持相对排版不变。 -->
    <view class="profile-foreground">
      <view class="hero-wash"></view>
      <view class="my-avatar">
        <image wx:if="{{profile.avatar}}" class="my-avatar-image" src="{{profile.avatar}}" mode="aspectFill" style="transform: translate({{profile.avatarOffsetX}}rpx, {{profile.avatarOffsetY}}rpx) scale({{profile.avatarScale}});"></image>
        <image wx:else class="my-avatar-image" src="/assets/images/profile-avatar-default.jpg" mode="aspectFill"></image>
      </view>
      <view class="my-name {{profile.name ? '' : 'my-name-empty'}}">{{profile.displayName}}</view>
      <view class="profile-meta"><view class="my-uid">UID {{profile.uid}}</view><view class="my-stats">{{profile.displayAge}}年同行年限 · {{profile.displayCampCount}}段社群经历</view></view>
      <view class="hero-hills"></view>
    </view>
  </view>
  <view class="received-panel card"><view class="received-heading"><view class="received-title">我收到的心意</view></view><view class="other-gifts-button tap" bindtap="toggleOtherGifts"><view class="other-gifts-label"><text>其</text><text>他</text><text>礼</text><text>物</text></view><text class="other-gifts-arrow">{{showOtherGifts ? '⌃' : '⌄'}}</text></view><view class="received-items primary-gifts"><view wx:for="{{primaryReceivedItems}}" wx:key="id" class="received-item"><image src="{{item.image}}" mode="aspectFill"></image><view>{{item.name}}</view><text>{{item.received}}</text></view></view><view wx:if="{{showOtherGifts}}" class="other-gifts"><view wx:if="{{otherReceivedItems.length}}" class="received-items other-gift-items"><view wx:for="{{otherReceivedItems}}" wx:key="id" class="received-item"><image src="{{item.image}}" mode="aspectFill"></image><view>{{item.name}}</view><text>{{item.received}}</text></view></view><view wx:else class="other-gifts-empty">无</view></view></view>
  <view class="profile-menu">
    <view class="menu-card card tap {{guideStep && guideStep.id === 'profile' ? 'feature-guide-focus' : ''}}" data-target="intro" bindtap="open"><view class="menu-icon intro-icon">♧</view><view class="menu-copy"><view>简介</view><text>了解我的成长与行动</text></view><view class="menu-arrow">›</view></view>
    <view class="menu-card card tap" data-target="favorites" bindtap="open"><view class="menu-icon favorites-icon">♥</view><view class="menu-copy"><view>收藏</view><text>我点赞的相册、记录、作品与评论</text></view><view class="menu-arrow">›</view></view>
    <view class="menu-card card tap" data-target="backpack" bindtap="open"><view class="menu-icon backpack-icon">◇</view><view class="menu-copy"><view>背包</view><text>查看并赠送当前拥有的心意道具</text></view><view class="menu-arrow">›</view></view>
    <view class="menu-card card tap" data-target="tasks" bindtap="open"><view class="menu-icon task-icon">✓</view><view class="menu-copy"><view>任务</view><text>完成每日任务与每周全勤奖励</text></view><view wx:if="{{taskRewardCount}}" class="menu-notice">{{taskRewardCount > 9 ? '9+' : taskRewardCount}}</view><view class="menu-arrow">›</view></view>
    <view class="menu-card card tap" data-target="mailbox" bindtap="open"><view class="menu-icon mail-icon">✉</view><view class="menu-copy"><view>邮箱</view><text>请接受独属于你的奖励</text></view><view wx:if="{{mailboxUnreadCount}}" class="menu-notice">{{mailboxUnreadCount > 9 ? '9+' : mailboxUnreadCount}}</view><view class="menu-arrow">›</view></view>
    <view wx:if="{{isAdmin}}" class="menu-card card tap" data-target="admin-rewards" bindtap="open"><view class="menu-icon admin-icon">令</view><view class="menu-copy"><view>开发者福利</view><text>向当前全部用户发放邮箱奖励</text></view><view class="menu-arrow">›</view></view>
    <view wx:if="{{isAdmin}}" class="menu-card card tap" data-target="work-review" bindtap="open"><view class="menu-icon review-icon">审</view><view class="menu-copy"><view>作品审核</view><text>{{pendingWorkCount ? '有 ' + pendingWorkCount + ' 件作品待审核，点击处理' : '暂无待审核作品'}}</text></view><view wx:if="{{pendingWorkCount}}" class="menu-notice">{{pendingWorkCount > 99 ? '99+' : pendingWorkCount}}</view><view class="menu-arrow">›</view></view>
    <view class="menu-card card tap" data-target="guide" bindtap="open"><view class="menu-icon guide-icon">✦</view><view class="menu-copy"><view>功能引导</view><text>了解各界面与常用按钮，可随时重看</text></view><view class="menu-arrow">›</view></view>
    <view class="menu-card card tap" data-target="settings" bindtap="open"><view class="menu-icon settings-icon">规</view><view class="menu-copy"><view>安全与协议</view><text>隐私保护、社区规范与数据权利</text></view><view class="menu-arrow">›</view></view>
    <view class="menu-card card tap" data-target="developer" bindtap="open"><view class="menu-icon developer-icon">序</view><view class="menu-copy"><view>关于模板</view><text>功能说明与二次开发入口</text></view><view class="menu-arrow">›</view></view>
  </view>
</view>
<feature-guide-overlay wx:if="{{guideStep}}" step="{{guideStep}}" index="{{guideIndex}}" total="{{guideTotal}}"></feature-guide-overlay>
