.profile-editor { padding-left:28rpx; padding-right:28rpx; }.editor-card { padding:25rpx 26rpx 30rpx; }.field-label { color:#1F513E; font-size:25rpx; font-weight:700; margin:16rpx 0 9rpx; }.text-input { height:68rpx; box-sizing:border-box; padding:0 14rpx; color:#20362C; background:#F8F6EF; border-radius:13rpx; font-size:27rpx; }.body-input { display:block; width:100%; min-height:160rpx; box-sizing:border-box; padding:16rpx; background:#F8F6EF; border-radius:13rpx; color:#20362C; font-size:26rpx; line-height:1.7; }
/* 个人头像和伙伴头像采用同一套直接拖动、双指缩放交互。 */
.avatar-crop-area { padding:21rpx 18rpx 18rpx; border-radius:16rpx; background:#F3F4EC; }.avatar-crop-circle { position:relative; width:220rpx; height:220rpx; margin:0 auto; overflow:hidden; border:6rpx solid #fff; border-radius:50%; background:#DDE8DE; box-shadow:0 6rpx 18rpx rgba(31,81,62,.16); }.avatar-crop-circle::after { content:""; position:absolute; top:12rpx; right:12rpx; bottom:12rpx; left:12rpx; border:1rpx solid rgba(255,255,255,.72); border-radius:50%; pointer-events:none; }.avatar-crop-image { display:block; width:100%; height:100%; transform-origin:center; }.crop-tip { margin:16rpx 0 10rpx; color:#718078; font-size:21rpx; text-align:center; }.avatar-photo-actions { display:flex; justify-content:center; flex-wrap:wrap; gap:13rpx; margin-top:7rpx; }.mini-photo-button,.clear-avatar { padding:8rpx 15rpx; border-radius:99rpx; font-size:21rpx; }.mini-photo-button { color:#fff; background:#416F51; }.mini-photo-button.secondary { color:#416F51; background:#E3EBE0; }.clear-avatar { color:#8B655B; background:#F9E9E4; }.avatar-picker { padding:31rpx; text-align:center; color:#607A68; background:#F3F4EC; border:2rpx dashed #C9D7C9; border-radius:16rpx; font-size:24rpx; }.avatar-plus { color:#1F513E; font-size:42rpx; }
.stats-inputs { display:flex; gap:16rpx; }.stat-field { flex:1; display:flex; align-items:center; padding:12rpx 14rpx; background:#F8F6EF; border-radius:13rpx; color:#607A68; font-size:20rpx; }.stat-field input { width:78rpx; color:#20362C; font-size:27rpx; text-align:center; }.stats-hint { margin-top:10rpx; color:#8A978D; font-size:20rpx; }.save-btn { margin:27rpx 5rpx 20rpx; }

.onboarding-note{margin:0 0 22rpx;padding:22rpx 26rpx;border:1rpx solid #DAE7DC;border-radius:20rpx;color:#61776A;background:#EEF5EE;font-size:24rpx;line-height:1.7}.onboarding-title{margin-bottom:8rpx;color:#24533D;font-size:30rpx;font-weight:700}.retry-profile{margin-top:18rpx;border:0;border-radius:99rpx;color:#fff;background:#416F51;font-size:26rpx}.retry-profile::after{border:0}
