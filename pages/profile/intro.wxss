/* 关于我采用正常文档流：横幅、名片和信息卡依次排列，不使用负边距或绝对定位。 */
.intro-page-v2 { min-height:100vh; padding:0 28rpx 270rpx; box-sizing:border-box; background:linear-gradient(180deg,#FAF8F0 0%,#F5F4EC 100%); }
.intro-hero-v2 { overflow:hidden; margin-top:4rpx; border-radius:24rpx; box-shadow:0 12rpx 28rpx rgba(39,70,52,.10); }
.intro-hero-v2 scene-banner { display:block; }

/* 个人身份与成长经历合并为一张资料卡，减少留白并保持信息层级。 */
.identity-card-v2 { margin:20rpx 0; padding:21rpx; border:1rpx solid rgba(255,255,255,.88); }
.identity-primary-v2 { display:flex; align-items:center; }
.identity-avatar-v2 { flex:0 0 auto; box-sizing:border-box; overflow:hidden; width:112rpx; height:112rpx; margin-right:19rpx; border:4rpx solid #FFFCF6; border-radius:50%; background:#DCE7D8; box-shadow:0 6rpx 16rpx rgba(31,81,62,.15); }
.identity-avatar-image-v2 { display:block; width:100%; height:100%; transform-origin:center; }
.identity-copy-v2 { min-width:0; flex:1; text-align:left; }
.identity-name-v2 { overflow:hidden; color:#1F513E; font-family:"Songti SC",SimSun,serif; font-size:37rpx; font-weight:700; line-height:1.35; white-space:nowrap; text-overflow:ellipsis; }
.identity-name-empty-v2 { color:#789080; font-size:29rpx; font-weight:400; }
.intro-id-chip-v2 { display:inline-flex; align-items:center; height:38rpx; margin-top:8rpx; padding:0 16rpx; box-sizing:border-box; border-radius:99rpx; color:#557463; background:#EDF2E9; font-size:20rpx; letter-spacing:1rpx; line-height:38rpx; white-space:nowrap; }
.identity-divider-v2 { height:1rpx; margin:19rpx 0 16rpx; background:#E8E9DE; }
.identity-stats-v2 { display:flex; align-items:center; padding:14rpx 15rpx; border-radius:16rpx; background:linear-gradient(100deg,#FFF8E8,#EDF1E4); }
.identity-stats-icon-v2 { display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:62rpx; height:62rpx; margin-right:14rpx; border-radius:15rpx; color:#4D7558; background:#E3EBDD; font-size:32rpx; }
.identity-stats-title-v2 { color:#345744; font-family:"Songti SC",SimSun,serif; font-size:26rpx; font-weight:700; }
.identity-stats-copy-v2 { margin-top:3rpx; color:#718078; font-size:20rpx; }

/* 内容卡统一使用相同标题层级，空内容也保持稳定的文字位置。 */
.intro-info-card-v2 { margin:17rpx 0; padding:24rpx 25rpx; }
.intro-card-heading-v2 { display:flex; align-items:center; }
.intro-card-icon-v2 { display:flex; align-items:center; justify-content:center; flex:0 0 auto; width:58rpx; height:58rpx; margin-right:15rpx; border-radius:50%; color:#51755B; background:#E7EEDB; font-size:29rpx; font-weight:700; }
.intro-card-icon-gold-v2 { color:#9A6A19; background:#F9EBCF; font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif; }
.intro-card-title-v2 { color:#294D3A; font-family:"Songti SC",SimSun,serif; font-size:29rpx; font-weight:700; }
.intro-card-subtitle-v2 { margin-top:2rpx; color:#849188; font-size:20rpx; }
.intro-bio-v2 { margin-top:18rpx; color:#42594C; font-size:26rpx; line-height:1.9; }
.intro-bio-empty-v2 { color:#718078; font-size:24rpx; }
.intro-tag-list-v2 { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:18rpx; }
.intro-tag-v2 { padding:9rpx 19rpx; border-radius:99rpx; color:#496755; background:#E8EEDC; font-size:23rpx; }
.intro-tag-v2:nth-child(2n) { color:#856326; background:#F8ECCE; }
.intro-empty-tags-v2 { margin-top:18rpx; color:#718078; font-size:22rpx; }

/* 按钮在自定义底栏上方固定显示，不影响页面内容滚动。 */
.intro-bottom-edit-v2 { position:fixed; z-index:99; bottom:200rpx; left:50%; width:310rpx; padding:16rpx 0; transform:translateX(-50%); border-radius:99rpx; color:#fff; background:#1F513E; box-shadow:0 9rpx 23rpx rgba(31,81,62,.28); font-size:27rpx; text-align:center; }
