.mailbox-page{padding:0 28rpx 70rpx}.mail-list{display:flex;flex-direction:column;gap:16rpx;margin-top:28rpx}.mail-card{padding:20rpx}.mail-heading{display:flex;justify-content:space-between;align-items:center;gap:14rpx}.mail-heading>view:first-child{min-width:0;color:#263F33;font-size:27rpx;font-weight:700}.mail-heading>text{flex:0 0 auto;color:#96A099;font-size:18rpx}.unread-dot{display:inline-block;width:13rpx;height:13rpx;margin-left:9rpx;border-radius:50%;background:#D95548;vertical-align:middle}.mail-body{margin-top:8rpx;color:#6D7D73;font-size:22rpx;line-height:1.55}.mail-message{margin-top:12rpx;padding:14rpx 16rpx;border-left:5rpx solid #DAB66C;border-radius:8rpx;color:#4F6557;background:#FAF5E8;font-size:22rpx;line-height:1.6}.mail-deadline{margin-top:11rpx;padding:9rpx 13rpx;border-radius:10rpx;color:#966724;background:#FFF4DF;font-size:20rpx;line-height:1.5}.mail-images{margin-top:13rpx;white-space:nowrap}.mail-images image{display:inline-block;width:150rpx;height:150rpx;margin-right:10rpx;border-radius:13rpx}.mail-foot{display:flex;align-items:center;margin-top:15rpx}.mail-foot-actions{display:flex;align-items:center;gap:9rpx;margin-left:auto}.reward-chip{padding:7rpx 13rpx;border-radius:99rpx;color:#93651A;background:#FFF0D1;font-size:20rpx}.claim-button,.claimed{padding:9rpx 17rpx;border-radius:99rpx;color:#fff;background:#2F674E;font-size:20rpx}.claimed{color:#728379;background:#E9EEE8}.mail-delete{padding:8rpx 14rpx;border-radius:99rpx;color:#A95146;background:#F8E9E5;font-size:19rpx}
.feedback-mail{border:1rpx solid rgba(46,121,96,.2);background:linear-gradient(180deg,#FFFEFA,#F5FAF6)}
.feedback-sender{display:flex;align-items:center;gap:14rpx;margin-top:16rpx;padding:14rpx;border-radius:15rpx;background:#EDF5EF}
.feedback-avatar-wrap,.feedback-avatar-fallback{width:68rpx;height:68rpx;flex:0 0 68rpx;border-radius:50%}
.feedback-avatar-wrap{overflow:hidden;background:#D7E4DB}
.feedback-avatar-wrap image{display:block;width:100%;height:100%;transform-origin:center}
.feedback-avatar-fallback{display:flex;align-items:center;justify-content:center;color:#fff;background:#5C8A73;font-size:27rpx}
.feedback-sender-copy{display:flex;min-width:0;flex-direction:column}
.feedback-sender-copy>view{overflow:hidden;color:#294B3A;font-size:25rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}
.feedback-sender-copy text{color:#718078;font-size:19rpx}
.feedback-bio{margin-top:10rpx;color:#607268;font-size:21rpx;line-height:1.55}
.feedback-tags{display:flex;flex-wrap:wrap;gap:8rpx;margin-top:9rpx}
.feedback-tags text,.feedback-chip{padding:5rpx 11rpx;border-radius:99rpx;color:#39725C;background:#E3F0E7;font-size:18rpx}
.feedback-content{margin-top:14rpx;padding:16rpx;border-left:5rpx solid #4A9274;border-radius:9rpx;color:#344F41;background:#F3F7F2;font-size:23rpx;white-space:pre-wrap}
.feedback-state{padding:9rpx 17rpx;border-radius:99rpx;color:#39725C;background:#E3F0E7;font-size:20rpx}
