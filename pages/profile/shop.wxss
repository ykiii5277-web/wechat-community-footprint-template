.shop-page{padding:0 28rpx 70rpx}.pay-mode{display:flex;align-items:center;justify-content:space-between;padding:17rpx 20rpx;color:#2C503D;font-size:25rpx;font-weight:700}.pay-mode text{padding:6rpx 12rpx;border-radius:99rpx;color:#8A641E;background:#FFF2D4;font-size:19rpx}.compliance-note{margin:15rpx 5rpx 20rpx;color:#7E8A82;font-size:20rpx;line-height:1.55}.product-list{display:flex;flex-direction:column;gap:16rpx}.product-card{display:flex;align-items:center;padding:18rpx}.product-card image{width:98rpx;height:98rpx;flex:0 0 98rpx;border-radius:23rpx}.product-copy{flex:1;min-width:0;margin-left:18rpx}.product-copy>view:first-child{color:#20362C;font-size:29rpx;font-weight:700}.product-copy text{display:block;margin-top:3rpx;color:#748178;font-size:20rpx}.product-price{margin-top:8rpx;color:#B16B18;font-size:24rpx;font-weight:700}.buy-button{margin-left:13rpx!important;color:#fff!important;background:#2F674E!important;border-radius:99rpx!important;font-size:21rpx!important}.shop-footnote{margin:23rpx 8rpx;color:#829088;font-size:20rpx;line-height:1.5}
