.tasks-page{padding:0 28rpx 70rpx}.task-date{margin:0 5rpx 17rpx;color:#7A887F;font-size:21rpx}.task-list{display:flex;flex-direction:column;gap:15rpx}.task-card{display:flex;align-items:center;padding:19rpx}.task-icon{display:flex;align-items:center;justify-content:center;width:76rpx;height:76rpx;flex:0 0 76rpx;border-radius:50%;color:#34664C;background:#E6EFE2;font-size:33rpx}.task-copy{flex:1;min-width:0;margin-left:16rpx}.task-copy>view:first-child{color:#233D31;font-size:27rpx;font-weight:700}.task-copy text{display:block;margin-top:3rpx;color:#7C8981;font-size:20rpx}.task-progress{margin-top:7rpx;color:#B07822;font-size:19rpx}.task-action,.weekly-button{padding:11rpx 16rpx;border-radius:99rpx;color:#fff;background:#2F674E;font-size:20rpx}.task-action.claimed,.weekly-button.claimed{color:#54725F;background:#E7EFE4}.task-action.disabled,.weekly-button.disabled{color:#969F99;background:#ECECE7}.weekly-card{margin-top:22rpx;padding:22rpx;background:linear-gradient(135deg,#FFF7E6,#F3F7EB)}.weekly-card.perfect-week{background:linear-gradient(135deg,#FFF1DF,#FBE3D5)}.weekly-heading{display:flex;justify-content:space-between;color:#2A4938;font-size:28rpx;font-weight:700}.weekly-heading text{color:#B17420}.weekly-copy{margin:8rpx 0 17rpx;color:#718078;font-size:21rpx;line-height:1.5}.weekly-button{text-align:center}
