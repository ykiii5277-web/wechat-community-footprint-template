<view wx:if="{{work}}" class="page-shell work-detail">
  <page-nav title="作品详情"></page-nav>
  <view class="work-detail-card card">
    <video wx:if="{{isVideo && videoUrl}}" class="work-video" src="{{videoUrl}}" controls="{{true}}" show-fullscreen-btn="{{true}}" object-fit="contain"></video>
    <view wx:elif="{{work.filePath}}" class="work-file-card tap" bindtap="openFile"><view class="work-file-icon">{{isVideo ? '▶' : '▤'}}</view><view class="work-file-copy"><view>{{work.fileName || '已上传的作品文件'}}</view><text>{{fileMeta || '点击打开文件'}}</text></view><view class="work-file-open">{{isVideo ? '播放' : '打开'}} ›</view></view>
    <image wx:elif="{{work.cover}}" class="work-cover" src="{{work.cover}}" mode="aspectFill"></image>
    <scene-banner wx:else scene="{{camp.scene}}"></scene-banner>
    <view class="work-detail-copy"><view class="work-detail-title">{{work.title}}</view><view class="work-detail-meta">{{work.date}}　·　{{camp.name}}　·　👁 {{work.views}} 浏览　·　♥ {{work.likes}} 点赞 <text wx:if="{{work.status === 'draft'}}" class="draft-badge">草稿</text></view><view class="content-visibility">可见范围 · {{work.visibilityLabel}}</view><view wx:if="{{work.location}}" class="work-detail-location">⌖ {{work.location}}</view><view wx:if="{{body}}" class="work-detail-body">{{body}}</view><view wx:else class="work-empty-body">暂未填写正文</view><view wx:if="{{isVideo && work.filePath}}" class="work-video-save tap" bindtap="saveVideo">保存视频到相册</view></view>
  </view>
  <view wx:if="{{work.reviewStatus === 'rejected' || work.visibility === 'public' && work.reviewStatus === 'pending'}}" class="work-note">{{work.reviewStatus === 'rejected' ? '附件审核未通过，已退回仅自己可见' : '附件待审核，当前仅自己可见'}}</view>
  <view class="work-actions"><view class="work-favorite tap" bindtap="favorite">{{work.favorite ? '♥ 已点赞' : '♡ 点赞'}} {{work.likes}}</view><view class="work-draft tap" bindtap="edit">编辑</view><view class="work-delete tap" bindtap="remove">删除</view></view><comment-panel target-type="work" target-id="{{work.id}}" bind:change="refresh"></comment-panel><view class="work-note">公开视频及文档附件需通过人工审核。</view>
</view>
