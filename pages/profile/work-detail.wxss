.work-detail { padding-left:28rpx; padding-right:28rpx; }.work-detail-card { overflow:hidden; }.work-detail-card scene-banner { display:block; }.work-cover { display:block; width:100%; height:292rpx; }.work-file-card { display:flex; align-items:center; padding:26rpx 24rpx; background:linear-gradient(135deg,#E8F0F2,#F7FAF8); }.work-file-icon { display:flex; align-items:center; justify-content:center; width:78rpx; height:78rpx; border-radius:18rpx; color:#fff; background:#4D7594; font-size:43rpx; }.work-file-copy { min-width:0; flex:1; margin-left:18rpx; color:#304A5D; font-size:27rpx; font-weight:700; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.work-file-copy text { display:block; margin-top:5rpx; color:#718078; font-size:20rpx; font-weight:400; }.work-file-open { margin-left:12rpx; color:#4D7594; font-size:21rpx; }.work-detail-copy { padding:27rpx; }.work-detail-title { color:#20362C; font-family:"Songti SC",SimSun,serif; font-size:39rpx; line-height:1.35; font-weight:700; }.work-detail-meta { color:#718078; font-size:21rpx; margin-top:10rpx; }.content-visibility { display:inline-block; margin-top:10rpx; padding:3rpx 9rpx; border-radius:99rpx; color:#557260; background:#EDF2E8; font-size:18rpx; }.work-detail-location { color:#667B70; font-size:22rpx; margin-top:14rpx; }.work-detail-body { white-space:pre-wrap; color:#42594C; line-height:2; font-size:27rpx; margin-top:27rpx; }.work-empty-body { margin-top:27rpx; color:#98A399; font-size:24rpx; }.work-actions { display:flex; gap:12rpx; margin-top:23rpx; }.work-favorite,.work-draft,.work-delete { flex:1; padding:15rpx 0; border-radius:99rpx; text-align:center; font-size:22rpx; }.work-favorite { color:#9A6A19; background:#FCF0D9; }.work-draft { color:#315F49; background:#E8F0E6; }.work-delete { color:#B3473A; background:#F8E8E4; }.work-note { color:#8C9A90; text-align:center; font-size:21rpx; margin:20rpx; }
.work-video { display:block; width:100%; height:420rpx; background:#111; }
.work-video-save { margin-top:17rpx; padding:12rpx 15rpx; border-radius:12rpx; color:#456175; background:#EAF0F2; font-size:23rpx; }
