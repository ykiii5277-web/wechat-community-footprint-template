.work-editor { padding-left:28rpx; padding-right:28rpx; }.editor-card { padding:25rpx 26rpx 30rpx; }.field-label { color:#1F513E; font-size:25rpx; font-weight:700; margin:16rpx 0 9rpx; }.text-input { height:68rpx; box-sizing:border-box; padding:0 14rpx; color:#20362C; background:#F8F6EF; border-radius:13rpx; font-size:27rpx; }.body-input { display:block; width:100%; min-height:160rpx; box-sizing:border-box; padding:16rpx; background:#F8F6EF; border-radius:13rpx; color:#20362C; font-size:26rpx; line-height:1.7; }.work-body { min-height:330rpx; }.picked-file { position:relative; display:flex; align-items:center; min-height:106rpx; box-sizing:border-box; padding:18rpx 88rpx 18rpx 20rpx; border-radius:16rpx; background:#E8F0F2; }.file-symbol { display:flex; align-items:center; justify-content:center; width:62rpx; height:62rpx; margin-right:17rpx; border-radius:14rpx; color:#fff; background:#4D7594; font-size:36rpx; }.file-copy { min-width:0; flex:1; color:#304A5D; font-size:25rpx; font-weight:700; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.file-copy text { display:block; margin-top:4rpx; color:#718078; font-size:20rpx; font-weight:400; }.file-action,.file-remove { position:absolute; color:#fff; background:#4D7594; font-size:20rpx; }.file-action { right:15rpx; bottom:15rpx; padding:6rpx 13rpx; border-radius:99rpx; }.file-remove { top:10rpx; right:13rpx; width:32rpx; height:32rpx; border-radius:50%; text-align:center; line-height:29rpx; font-size:27rpx; }.picker-field { background:#F8F6EF; border-radius:13rpx; padding:17rpx; color:#52675A; }.picker-field text { float:right; color:#1F513E; font-size:35rpx; line-height:25rpx; }.visibility-hint { margin:7rpx 5rpx 1rpx; color:#859187; font-size:20rpx; }.save-row { display:flex; margin:27rpx 33rpx; }.publish-button { flex:1; min-width:0; margin:0; }
.media-choices { display:flex; gap:16rpx; margin:16rpx 0; }
.media-choices view { flex:1; padding:17rpx 8rpx; border-radius:16rpx; color:#24583F; background:#E8F0E6; text-align:center; font-size:24rpx; }
.work-video { width:100%; height:390rpx; margin:18rpx 0; background:#111; }

.attachment-review-note{margin:12rpx 0;color:#718078;font-size:22rpx;line-height:1.6;}
