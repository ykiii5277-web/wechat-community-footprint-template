.review-page{padding:0 28rpx 50rpx}.review-note,.review-meta,.review-state{color:#718078;font-size:23rpx;line-height:1.6}.review-note{padding:18rpx 0}.review-state{padding:50rpx 20rpx;text-align:center}.review-card{padding:24rpx;margin-bottom:22rpx}.review-title{color:#20362C;font-size:30rpx;font-weight:700}.review-meta{margin-top:8rpx;overflow-wrap:anywhere}.review-body{margin-top:16rpx;white-space:pre-wrap;font-size:25rpx;color:#52675A}.review-video{width:100%;height:360rpx;margin-top:20rpx}.review-open{padding:22rpx 0;color:#1F513E;font-size:26rpx}.review-check{display:flex;align-items:center;font-size:23rpx;color:#52675A;margin-top:20rpx}.review-actions{display:flex;gap:16rpx;margin-top:22rpx}.review-actions button{flex:1;min-width:0;margin:0;font-size:25rpx;border-radius:99rpx;background:#F8E7E2;color:#A34337}.review-actions .approve{background:#1F513E;color:white}.review-actions button[disabled]{opacity:.5}
.rejection-mask{position:fixed;inset:0;z-index:1000;display:flex;align-items:center;justify-content:center;padding:36rpx;background:rgba(0,0,0,.45);box-sizing:border-box}.rejection-dialog{width:100%;max-width:640rpx;padding:30rpx;box-sizing:border-box}.rejection-work{max-height:100rpx;overflow:auto}.rejection-hint{margin:18rpx 0;color:#718078;font-size:23rpx;line-height:1.6}.rejection-input{width:100%;height:180rpx;padding:18rpx;box-sizing:border-box;border-radius:14rpx;background:#F2F3EC;color:#263F33;font-size:26rpx;line-height:1.6}.rejection-count{text-align:right;margin-top:8rpx;color:#96A099;font-size:21rpx}
