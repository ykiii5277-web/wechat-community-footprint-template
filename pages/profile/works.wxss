.works-page { padding-left:28rpx; padding-right:28rpx; padding-bottom:170rpx; }.works-top { margin:3rpx 7rpx 21rpx; }.works-intro { color:#718078; font-size:23rpx; }.draft-hint { margin:-9rpx 7rpx 18rpx; color:#8A6C31; font-size:21rpx; }.works-list { display:flex; flex-direction:column; gap:20rpx; }.work-card { position:relative; display:flex; overflow:hidden; min-height:191rpx; }.work-art { flex:0 0 220rpx; width:220rpx; overflow:hidden; }.work-art image { display:block; width:100%; height:100%; }.work-art scene-banner { display:block; height:100%; }.work-file-art { display:flex; align-items:center; justify-content:center; width:100%; height:100%; color:#4D7594; background:linear-gradient(145deg,#E8F0F2,#DCE8EB); font-size:70rpx; }.work-copy { min-width:0; flex:1; padding:23rpx 12rpx 18rpx 22rpx; }.work-title { overflow:hidden; white-space:nowrap; text-overflow:ellipsis; color:#20362C; font-family:"Songti SC",SimSun,serif; font-size:30rpx; font-weight:700; }.work-date { color:#718078; font-size:21rpx; margin-top:13rpx; }.draft-badge { display:inline-block; margin-left:9rpx; padding:2rpx 9rpx; border-radius:99rpx; color:#8A6C31; background:#FFF0D2; font-size:18rpx; }.work-file-name,.work-location { color:#718078; font-size:20rpx; margin-top:5rpx; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }.work-file-name { color:#4D7594; }.work-views { color:#718078; font-size:20rpx; margin-top:10rpx; }.work-arrow { position:absolute; right:15rpx; top:50%; margin-top:-25rpx; color:#1F513E; font-size:47rpx; }.fixed-create-bar { position:fixed; z-index:10; right:0; bottom:0; left:0; padding:18rpx 28rpx calc(env(safe-area-inset-bottom) + 18rpx); background:linear-gradient(180deg,rgba(248,245,237,0),#F8F5ED 30%); }.fixed-create-button { padding:19rpx 0; border-radius:99rpx; color:#fff; background:#1F513E; box-shadow:0 8rpx 20rpx rgba(31,81,62,.22); font-size:28rpx; text-align:center; }
