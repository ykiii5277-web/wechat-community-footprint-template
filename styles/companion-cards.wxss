.companions-top { margin:0 4rpx 18rpx; }
.companions-top .section-label { margin:0; }
.people-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:18rpx; }
.person-card { overflow:hidden; padding:19rpx 15rpx 17rpx; text-align:center; }
.avatar { position:relative; overflow:hidden; width:134rpx; height:134rpx; margin:0 auto 9rpx; border-radius:50%; background:#E6EDDF; }
.avatar-image { display:block; width:100%; height:100%; transform-origin:center; }
.avatar-face { position:absolute; z-index:2; left:43rpx; top:28rpx; width:48rpx; height:52rpx; border-radius:48% 48% 45% 45%; background:#E9BF9A; }
.avatar-face:before { content:''; position:absolute; width:58rpx; height:27rpx; border-radius:42rpx 42rpx 0 0; background:#384237; top:-8rpx; left:-5rpx; }
.avatar-shirt { position:absolute; z-index:1; bottom:-13rpx; left:21rpx; width:92rpx; height:86rpx; border-radius:50rpx 50rpx 0 0; background:#426E58; }
.avatar-1 { background:#F0E7D3; }
.avatar-1 .avatar-shirt { background:#A47C45; }
.avatar-2 { background:#E4EFF0; }
.avatar-2 .avatar-shirt { background:#557F9A; }
.avatar-3 { background:#F3E4D9; }
.avatar-3 .avatar-shirt { background:#C84A3A; }
.person-name { color:#20362C; font-size:28rpx; font-weight:700; }
.person-gender { color:#718078; font-size:20rpx; margin-top:1rpx; }
.person-visibility { display:inline-block; margin-top:5rpx; padding:2rpx 8rpx; border-radius:99rpx; color:#557260; background:#EDF2E8; font-size:17rpx; }
.person-intro { overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; color:#607268; font-size:21rpx; line-height:1.5; margin-top:8rpx; text-align:left; }
